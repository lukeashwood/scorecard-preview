---
import '../styles/global.css';
import { SITE, NAV, NAV_GROUPS, FOOTER_NAV, url } from '../config/site';
import { GENERATED_AT } from '../lib/measures';
import { fmtStamp } from '../lib/format';
import { clip } from '../lib/seo';
import Logo from '../components/Logo.astro';
import SiteSearch from '../components/SiteSearch.astro';
import DisplayMenu from '../components/DisplayMenu.astro';

interface Props { title?: string; fullTitle?: string; description?: string; section?: string; jsonld?: Record<string, unknown> | Record<string, unknown>[]; bodyClass?: string; forceDark?: boolean; ogType?: string; ogImage?: string }
const { title, fullTitle: fullTitleProp, description: descRaw = SITE.description, section = '', jsonld, bodyClass, forceDark = false, ogType = 'website', ogImage } = Astro.props;
const ogImg = new URL(ogImage ?? url('og.png'), Astro.site).href;
// " | Gov Score" is 12 characters; adding it to a title of 49 or more would pass the 60 that Google shows in full.
const fullTitle = fullTitleProp ?? (title ? (title.length > 48 ? title : `${title} | ${SITE.name}`) : `${SITE.name} | ${SITE.tagline}`);
const description = clip(descRaw, 160);
const ldList = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
/* Breadcrumbs for search engines on every page below the home page, unless the page supplies its own.
   Names come from the navigation labels where the path is a nav item, otherwise the page title. */
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const crumbPath = Astro.url.pathname.startsWith(basePath) ? Astro.url.pathname.slice(basePath.length).replace(/\/+$/, '') : '';
if (crumbPath && crumbPath !== '404' && !ldList.some((ld) => ld['@type'] === 'BreadcrumbList')) {
  const labels: Record<string, string> = Object.fromEntries([...NAV, ...FOOTER_NAV].map((n) => [n.href.replace(/\/$/, ''), n.label]));
  const segs = crumbPath.split('/');
  const items = [{ '@type': 'ListItem', position: 1, name: SITE.name, item: new URL(url(), Astro.site).href }];
  segs.forEach((seg, i) => {
    const p = segs.slice(0, i + 1).join('/');
    const last = i === segs.length - 1;
    const name = labels[p] ?? (last && title ? title : seg.replace(/[-_]/g, ' ').replace(/^\w/, (c) => c.toUpperCase()));
    items.push({ '@type': 'ListItem', position: i + 2, name, item: new URL(url(`${p}/`), Astro.site).href });
  });
  ldList.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items });
}
const preview = import.meta.env.PUBLIC_PREVIEW === '1';
---
<!doctype html>
<html lang="en-AU" data-force-dark={forceDark ? '' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function (d) { var g = function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } };
      var t = g('sc_theme'); if (d.hasAttribute('data-force-dark')) t = 'dark'; if (t === 'dark' || t === 'light') d.setAttribute('data-theme', t);
      var a = g('sc_accent'); if (a && a !== 'indigo') d.setAttribute('data-accent', a);
      if (g('sc_motion') === 'off') d.setAttribute('data-motion', 'off');
      if (g('sc_text') === 'large') d.setAttribute('data-text', 'large');
      d.classList.add('js'); })(document.documentElement);
  </script>
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  <link rel="icon" href={url('favicon.ico')} sizes="16x16 32x32 48x48" />
  <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
  <link rel="manifest" href={url('site.webmanifest')} />
  <meta name="theme-color" content="#080b1a" />
  <meta name="google-site-verification" content="l_yJ3ldIbXNmhg7CCztrqJ_kpc9l-NtAu3EAOJeff3g" />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="en_AU" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImg} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${SITE.name}: the federal government in its own numbers`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImg} />
  {preview && <meta name="robots" content="noindex, nofollow" />}
  <link rel="sitemap" href={url('sitemap-index.xml')} />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: latest figures`} href={url('feed.xml')} />
  {ldList.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
</head>
<body class={bodyClass}>
  <a class="skip" href="#main">Skip to content</a>
  {preview && <p class="no-print bg-ink px-4 py-1.5 text-center text-[13px] font-semibold text-paper">Private preview. Not launched, not for sharing. Some sections are still being finalised.</p>}
  <header class="site sticky top-0 z-40 border-b border-rule bg-paper/90 backdrop-blur">
    <div class="aurora-line" aria-hidden="true"></div>
    <div class="wrap flex h-16 items-center gap-4">
      <a href={url()} class="flex items-center gap-2.5 text-ink no-underline" aria-label={`${SITE.name} ${SITE.edition} home`}>
        <Logo size={32} />
        <span class="leading-none">
          <span class="block font-display text-[19px] font-semibold tracking-tight">{SITE.name}</span>{' '}
          <span class="mono block pt-0.5 text-[10.5px] uppercase tracking-[0.12em] text-ink-3">{SITE.edition}</span>
        </span>
      </a>
      <nav class="ml-auto hidden items-center gap-0.5 lg:flex" aria-label="Main">
        {NAV.filter((n) => n.top).map((n) => (
          <a href={url(n.href)} aria-current={section === n.href ? 'page' : undefined}
             class="rounded-lg px-2.5 py-2 text-[14.5px] font-semibold text-ink-2 no-underline transition-colors hover:bg-panel hover:text-ink aria-[current=page]:bg-brand-tint aria-[current=page]:text-brand">{n.label}</a>
        ))}
        <details class="nav-more relative" id="nav-more">
          <summary class:list={['flex cursor-pointer list-none items-center gap-1 rounded-lg px-2.5 py-2 text-[14.5px] font-semibold text-ink-2 hover:bg-panel hover:text-ink [&::-webkit-details-marker]:hidden', NAV.some((n) => !n.top && n.href === section) && 'bg-brand-tint text-brand']}>More <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></summary>
          <div class="absolute right-0 z-50 mt-2 w-[260px] rounded-xl border border-rule bg-surface p-2 shadow-card">
            {NAV_GROUPS.filter((g) => g.items.some((n) => !n.top)).map((g) => (
              <div class="py-1"><p class="px-2.5 pb-1 pt-1.5 text-[11.5px] font-bold uppercase tracking-[0.08em] text-ink-3">{g.q}</p>
                {g.items.filter((n) => !n.top).map((n) => <a href={url(n.href)} aria-current={section === n.href ? 'page' : undefined} class="block rounded-lg px-2.5 py-2 text-[14.5px] font-semibold text-ink no-underline hover:bg-panel aria-[current=page]:text-brand">{n.label}</a>)}</div>
            ))}
          </div>
        </details>
      </nav>
      <div class="ml-auto flex items-center gap-2 lg:ml-2">
        <SiteSearch class="hidden w-[210px] xl:block 2xl:w-[260px]" id="site-search" />
        <a href={url('my/')} class="btn btn-ghost btn-sm hidden whitespace-nowrap sm:inline-flex" data-my-link aria-label="My Gov Score"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17.5l-5.4 2.9 1-6.1L3.2 10l6.1-.9z" /></svg><span class="hidden 2xl:inline">My Gov Score</span><span class="fav-count hidden rounded-full bg-brand px-1.5 text-[11px] font-bold text-on-brand"></span></a>
        <a href={url('subscribe/')} class="btn btn-primary btn-sm hidden whitespace-nowrap sm:inline-flex">Get updates</a>
        <DisplayMenu />
        <button type="button" id="menu-btn" class="btn btn-ghost btn-sm w-9 !px-0 lg:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>
    </div>
    <nav id="mobile-nav" class="max-h-[calc(100vh-64px)] overflow-y-auto border-t border-rule bg-paper lg:hidden" aria-label="Main (mobile)" hidden>
      <div class="wrap grid gap-3 py-4">
        <SiteSearch id="site-search-m" />
        <a href={url('find/')} class="rounded-lg px-3 py-2.5 text-[16px] font-semibold text-brand no-underline hover:bg-panel">Not sure? Let us help you find it →</a>
        <a href={url('my/')} class="rounded-lg px-3 py-2.5 text-[16px] font-semibold text-ink no-underline hover:bg-panel">★ My Gov Score</a>
        {NAV_GROUPS.map((g) => (
          <div><p class="px-3 pb-1 text-[11.5px] font-bold uppercase tracking-[0.08em] text-ink-3">{g.q}</p>
            <div class="grid">{g.items.map((n) => <a href={url(n.href)} aria-current={section === n.href ? 'page' : undefined} class="rounded-lg px-3 py-2.5 text-[16px] font-semibold text-ink no-underline aria-[current=page]:bg-brand-tint aria-[current=page]:text-brand">{n.label}</a>)}</div></div>
        ))}
        <a href={url('subscribe/')} class="btn btn-primary mt-1">Get updates</a>
      </div>
    </nav>
  </header>

  <main id="main" tabindex="-1" class="outline-none"><slot /></main>

  <footer class="site mt-24 border-t border-rule bg-panel">
    <div class="wrap grid gap-10 py-12 sm:grid-cols-3 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div class="max-w-md sm:col-span-3 lg:col-span-1">
        <p class="flex items-center gap-2.5 font-display text-[22px] font-semibold"><Logo size={26} />{SITE.name}</p>
        <p class="mt-2 text-[14.5px] text-ink-2">Official Australian figures, sourced line by line. Automatic figures are tested every day; figures entered by hand show the date they were checked. Verdicts are given only where someone in authority made a measurable commitment. Everything else is shown as it is.</p>
        <p class="meta mt-4">Data last checked <span class="mono">{fmtStamp(GENERATED_AT)}</span> · Rating rules v{SITE.rulesVersion}</p>
      </div>
      {[{ h: 'The record', items: [...NAV_GROUPS[0].items, ...NAV_GROUPS[1].items] }, { h: 'Explore', items: [...NAV_GROUPS[2].items, ...NAV_GROUPS[3].items] }].map((g) => (
      <div>
        <p class="eyebrow mb-3">{g.h}</p>
        <ul class="grid gap-2 text-[14.5px]">{g.items.map((n) => <li><a class="text-ink-2 no-underline hover:text-ink hover:underline" href={url(n.href)}>{n.label}</a></li>)}</ul>
      </div>))}
      <div>
        <p class="eyebrow mb-3">About the site</p>
        <ul class="grid gap-2 text-[14.5px]">{FOOTER_NAV.map((n) => <li><a class="text-ink-2 no-underline hover:text-ink hover:underline" href={url(n.href)}>{n.label}</a></li>)}</ul>
      </div>
    </div>
    <div class="border-t border-rule">
      <div class="wrap flex flex-wrap items-center justify-between gap-3 py-5 text-[13px] text-ink-3">
        <p>ABS and RBA material is used under Creative Commons Attribution 4.0. Verdicts and explanations are this site’s own, made under the published rules.</p>
        <p><a class="text-ink-3" href={url('corrections/')}>Spotted a mistake? Tell us.</a></p>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var mb = document.getElementById('menu-btn'), mn = document.getElementById('mobile-nav');
      mb && mb.addEventListener('click', function () { var open = mn.hidden; mn.hidden = !open; mb.setAttribute('aria-expanded', String(open)); });
      document.addEventListener('click', function (e) { var b = e.target.closest && e.target.closest('[data-share]'); if (!b) return;
        var text = b.getAttribute('data-text'), link = b.getAttribute('data-url'), lab = b.querySelector('[data-share-label]'), old = lab ? lab.textContent : '';
        var done = function (msg) { if (lab) { lab.textContent = msg; setTimeout(function () { lab.textContent = old; }, 2200); } };
        if (navigator.share) { navigator.share({ text: text, url: link }).catch(function () {}); return; }
        var all = text + ' ' + link;
        if (navigator.clipboard) navigator.clipboard.writeText(all).then(function () { done('Copied'); }, function () { done('Copy failed'); }); else done('Copy failed'); });
      var more = document.getElementById('nav-more');
      if (more) { document.addEventListener('click', function (e) { if (more.open && !more.contains(e.target)) more.open = false; }); document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && more.open) { more.open = false; more.querySelector('summary').focus(); } }); }
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && mn && !mn.hidden) { mn.hidden = true; mb.setAttribute('aria-expanded', 'false'); mb.focus(); } });
    })();
  </script>
<script is:inline>
  (function () {
    var KEY = 'gs_favs';
    function read() { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; } }
    function write(f) { try { localStorage.setItem(KEY, JSON.stringify(f)); } catch (e) {} }
    function count() { var n = read().length; document.querySelectorAll('.fav-count').forEach(function (c) { c.textContent = n; c.classList.toggle('hidden', !n); }); }
    document.querySelectorAll('[data-fav]').forEach(function (b) {
      var k = b.dataset.fav, lab = b.querySelector('.fav-label');
      function paint() { var on = read().indexOf(k) >= 0; b.setAttribute('aria-pressed', on ? 'true' : 'false'); if (lab) lab.textContent = on ? 'Saved' : 'Save'; }
      b.addEventListener('click', function () { var f = read(), i = f.indexOf(k); if (i >= 0) f.splice(i, 1); else f.push(k); write(f); paint(); count(); });
      paint();
    });
    count();
  })();
</script>
</body>
</html>
