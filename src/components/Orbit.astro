---
/* The hero orbit: real charts from the site's own data circling the mark. Each card is drawn at build time from the
   same series as its measure page, in a different chart form (line, area, bars, dots) so the ring reads as a set of
   real charts and not one chart repeated. Positions are set by a small script; without it the cards sit in a grid. */
import ParticleMark from './ParticleMark.astro';
import { url } from '../config/site';
import { byId, ratedSeries, TODAY } from '../lib/measures';
import { headlineText } from '../lib/format';
import type { Measure, Point } from '../lib/types';

const IDS = ['inflation', 'unemployment', 'mortgage', 'home_prices', 'gross_debt', 'employment', 'real_wages', 'fuel_prices', 'electricity', 'migration', 'budget_balance', 'rents_vs_wages'];
const FORMS = ['line', 'area', 'bars', 'dots'] as const;
const W = 150, H = 54, pad = 3;

function geometry(m: Measure) {
  const rs = ratedSeries(m); if (!rs) return null;
  const actual = (pts: Point[]) => pts.filter((p) => p[0] <= TODAY && (!m.chart.estimateFrom || p[0] < m.chart.estimateFrom));
  let pts = actual(rs.points);
  if (pts.length && pts[0][0] > '2022-06-30' && m.chart.series?.[0]) { const s = pts[0][0]; pts = [...actual(m.chart.series[0].points).filter((p) => p[0] < s), ...pts]; }
  pts = pts.filter((p) => p[0] >= '2016-01-01');
  if (pts.length > 60) { const k = Math.ceil(pts.length / 60); pts = pts.filter((_, i) => i % k === 0 || i === pts.length - 1); }
  if (pts.length < 3) return null;
  const ts = pts.map((p) => Date.parse(p[0])), vs = pts.map((p) => p[1]);
  let lo = Math.min(...vs), hi = Math.max(...vs); if (hi === lo) { hi += 1; lo -= 1; }
  const t0 = ts[0], t1 = ts[ts.length - 1];
  const X = (t: number) => pad + ((t - t0) / (t1 - t0 || 1)) * (W - pad * 2);
  const Y = (v: number) => H - pad - ((v - lo) / (hi - lo)) * (H - pad * 2);
  const xy = pts.map((p, i) => [X(ts[i]), Y(p[1])] as const);
  const line = xy.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join('');
  const zero = Math.min(H - pad, Math.max(pad, Y(Math.max(lo, Math.min(0, hi)))));
  return { xy, line, zero, ex: X(Date.parse('2022-05-23')) };
}

const cards = IDS.map(byId).filter(Boolean).map((m, i) => ({ m: m!, g: geometry(m!), form: FORMS[i % FORMS.length], now: headlineText(m!.headline) })).filter((c) => c.g);
---
<div class="orbit" data-orbit>
  <div class="orbit-centre"><ParticleMark size={440} /></div>
  <ul class="orbit-ring" aria-label="A selection of measures">
    {cards.map(({ m, g, form, now }, i) => (
      <li class="orbit-item" style={`--n:${i};--count:${cards.length}`}>
        <a href={url(`measures/${m.id}/`)} class="orbit-card" aria-label={`${m.title}: now ${now}`}>
          <span class="orbit-title">{m.title}</span>
          <span class="orbit-now">{now}</span>
          <svg viewBox={`0 0 ${W} ${H}`} class="orbit-chart" aria-hidden="true" preserveAspectRatio="none">
            <line x1={g!.ex} x2={g!.ex} y1="0" y2={H} class="orbit-election" />
            {form === 'line' && <path d={g!.line} class="orbit-line" />}
            {form === 'area' && <><path d={`${g!.line}L${g!.xy[g!.xy.length - 1][0].toFixed(1)} ${H}L${g!.xy[0][0].toFixed(1)} ${H}Z`} class="orbit-fill" /><path d={g!.line} class="orbit-line" /></>}
            {form === 'bars' && g!.xy.map(([x, y]) => <rect x={x - Math.max(0.8, (W / g!.xy.length) * 0.55) / 2} y={Math.min(y, g!.zero)} width={Math.max(0.8, (W / g!.xy.length) * 0.55)} height={Math.max(0.6, Math.abs(g!.zero - y))} class="orbit-bar" />)}
            {form === 'dots' && g!.xy.map(([x, y]) => <circle cx={x} cy={y} r="1.6" class="orbit-dot" />)}
            <circle cx={g!.xy[g!.xy.length - 1][0]} cy={g!.xy[g!.xy.length - 1][1]} r="3" class="orbit-end" />
          </svg>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .orbit { position: relative; width: 100%; max-width: 760px; aspect-ratio: 1 / 0.92; margin-inline: auto; }
  .orbit-centre { position: absolute; left: 50%; top: 50%; width: 58%; translate: -50% -50%; z-index: 2; pointer-events: auto; }
  .orbit-ring { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .orbit-item { position: absolute; left: 50%; top: 50%; width: clamp(128px, 22%, 176px); translate: -50% -50%; will-change: transform; }
  /* Without the script: a ring laid out with CSS so the hero never looks broken. */
  :global(html:not(.js)) .orbit-item { transform: rotate(calc(var(--n) * (360deg / var(--count)))) translateY(-41cqmin) rotate(calc(var(--n) * (-360deg / var(--count)))); }
  .orbit-card { display: grid; gap: 2px; padding: 10px 11px 8px; border-radius: 12px; text-decoration: none; color: var(--on-night); background: rgb(255 255 255 / 0.06); border: 1px solid rgb(255 255 255 / 0.12); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); box-shadow: 0 14px 34px -18px rgb(0 0 0 / 0.8); transition: border-color 160ms ease, background-color 160ms ease; }
  .orbit-card:hover, .orbit-card:focus-visible { border-color: var(--brand-glow); background: rgb(255 255 255 / 0.1); }
  .orbit-title { font-size: 11.5px; font-weight: 600; line-height: 1.25; color: var(--on-night-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .orbit-now { font-family: var(--font-display); font-size: 21px; font-weight: 600; line-height: 1.05; font-variant-numeric: tabular-nums; }
  .orbit-chart { width: 100%; height: 44px; margin-top: 4px; }
  .orbit-election { stroke: var(--brand-glow); stroke-width: 1; stroke-dasharray: 2 3; opacity: 0.8; vector-effect: non-scaling-stroke; }
  .orbit-line { fill: none; stroke: var(--aurora-1); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .orbit-fill { fill: var(--aurora-1); opacity: 0.22; }
  .orbit-bar { fill: var(--brand-glow); opacity: 0.85; }
  .orbit-dot { fill: var(--aurora-3); opacity: 0.9; }
  .orbit-end { fill: #fff; stroke: var(--night); stroke-width: 1.5; }
  @media (max-width: 640px) { .orbit { aspect-ratio: 1 / 1.1; max-width: 420px; } .orbit-centre { width: 60%; } .orbit-item { width: 118px; } .orbit-item:nth-child(n+8) { display: none; } .orbit-now { font-size: 17px; } .orbit-chart { height: 34px; } .orbit-card { padding: 8px 9px 6px; } }
</style>

<script>
  // Cards travel around a tilted ring: an ellipse on screen, with the far side smaller and dimmer, so the ring reads
  // as a circle seen at an angle and the cards pass behind the mark. Pointer over the ring slows it; pointer over a
  // card holds it still so it can be read and clicked.
  function run(orbit: HTMLElement) {
    const all = Array.from(orbit.querySelectorAll<HTMLElement>('.orbit-item'));
    let items = all, n = all.length; if (!n) return;
    const pickVisible = () => { items = all.filter((el) => getComputedStyle(el).display !== 'none'); n = items.length; };
    pickVisible();
    const root = document.documentElement;
    const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches || root.getAttribute('data-motion') === 'off';
    let angle = 0, speed = 1, target = 1, last = 0, raf = 0, visible = true;
    const PERIOD = 46; // seconds for one lap
    function place() {
      const W = orbit.clientWidth, H = orbit.clientHeight, small = W < 520, rx = W * (small ? 0.38 : 0.42), ry = H * (small ? 0.38 : 0.30);
      for (let i = 0; i < n; i++) {
        const a = angle + (i / n) * Math.PI * 2;
        const x = Math.cos(a) * rx, y = Math.sin(a) * ry, depth = (Math.sin(a) + 1) / 2; // 1 = front, 0 = back
        const s = (small ? 0.78 : 0.72) + depth * (small ? 0.26 : 0.36), el = items[i];
        el.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) scale(${s.toFixed(3)})`;
        el.style.opacity = (0.35 + depth * 0.65).toFixed(2);
        el.style.zIndex = depth > 0.5 ? '3' : '1';
      }
    }
    function frame(now: number) {
      raf = 0; if (!visible) return;
      const dt = Math.min(0.05, (now - (last || now)) / 1000); last = now;
      speed += (target - speed) * 0.08;
      angle += (dt / PERIOD) * Math.PI * 2 * speed;
      place();
      if (!reduced()) raf = requestAnimationFrame(frame);
    }
    function go() { if (reduced()) { place(); return; } last = 0; if (!raf) raf = requestAnimationFrame(frame); }
    orbit.addEventListener('pointerenter', () => { target = 0.25; });
    orbit.addEventListener('pointerleave', () => { target = 1; });
    items.forEach((el) => { el.addEventListener('pointerenter', () => { target = 0; }); el.addEventListener('pointerleave', () => { target = 0.25; }); el.addEventListener('focusin', () => { target = 0; }); el.addEventListener('focusout', () => { target = 1; }); });
    new ResizeObserver(() => { pickVisible(); place(); }).observe(orbit);
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; if (visible) go(); }, { threshold: 0.05 }).observe(orbit);
    document.addEventListener('displaychange', go);
    place(); go();
  }
  document.querySelectorAll<HTMLElement>('[data-orbit]').forEach(run);
</script>
