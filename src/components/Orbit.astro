---
/* The hero orbit: real charts from the site's own data circling the mark, like screens around an invisible sphere.
   Each card is drawn at build time from the same series as its measure page, and every card is a different chart
   form (line, area, bars, scatter, step, lollipop, slope, heat strip, donut, gauge, pictogram, radial bars) so the
   ring reads as a gallery of real charts. Positions and tilt are set by a small script; without it the cards sit
   in a plain ring. */
import { url } from '../config/site';
import { byId, ratedSeries, TODAY } from '../lib/measures';
import { headlineText } from '../lib/format';
import { accordProgress } from '../lib/accord';
import { powerBills, wageNote, mortgageDays, ndisCoins, workCrowd, renewablesShare, budgetWaterline } from '../lib/pictures';
import type { Measure, Point } from '../lib/types';

/* The pool of screens. The ring shows 8 at a time and moves 4 places along the pool each day, so the hero changes
   daily. The pool alternates measures that have improved with ones that have worsened, so any window of 8 stays a
   mix rather than leaning one way. */
const POOL: [string, string][] = [
  ['inflation', 'line'], ['housing_accord', 'houses'], ['employment', 'crowd'], ['mortgage', 'days'],
  ['gross_debt', 'step'], ['power_bills', 'arrows'], ['budget_balance', 'waterline'], ['real_wages', 'note'],
  ['wholesale_gas', 'area'], ['bulk_billing', 'people'], ['gender_pay_gap', 'line'], ['renewables-82', 'sun'],
  ['unemployment', 'area'], ['ndis', 'coins'], ['womens_participation', 'bars'], ['emissions_target', 'goal'],
];
const day = Math.floor(Date.parse(TODAY) / 864e5);
const start = (day * 4) % POOL.length;
const SET = Array.from({ length: 8 }, (_, k) => POOL[(start + k) % POOL.length]);
/* Picture forms stand on their own figure and need no time series. */
const PICTURE = ['houses', 'people', 'goal', 'donut', 'gauge', 'pictogram', 'crowd', 'days', 'arrows', 'note', 'coins', 'waterline', 'sun'];
const accord = accordProgress();
const emis = byId('emissions_target');
const emisTarget = emis?.chart.bars?.find((b) => /target/i.test(b.name))?.value ?? 43;
const pw = powerBills(), wg = wageNote(), md = mortgageDays(), nd = ndisCoins(), cr = workCrowd(), rn = renewablesShare(), bw = budgetWaterline();
const W = 150, H = 54, pad = 3;

function geometry(m: Measure) {
  const rs = ratedSeries(m); if (!rs) return null;
  const actual = (pts: Point[]) => pts.filter((p) => p[0] <= TODAY && (!m.chart.estimateFrom || p[0] < m.chart.estimateFrom));
  let pts = actual(rs.points);
  if (pts.length && pts[0][0] > '2022-06-30' && m.chart.series?.[0]) { const s = pts[0][0]; pts = [...actual(m.chart.series[0].points).filter((p) => p[0] < s), ...pts]; }
  pts = pts.filter((p) => p[0] >= '2016-01-01');
  if (pts.length > 48) { const k = Math.ceil(pts.length / 48); pts = pts.filter((_, i) => i % k === 0 || i === pts.length - 1); }
  if (pts.length < 3) return null;
  const ts = pts.map((p) => Date.parse(p[0])), vs = pts.map((p) => p[1]);
  let lo = Math.min(...vs), hi = Math.max(...vs); if (hi === lo) { hi += 1; lo -= 1; }
  const t0 = ts[0], t1 = ts[ts.length - 1];
  const X = (t: number) => pad + ((t - t0) / (t1 - t0 || 1)) * (W - pad * 2);
  const Y = (v: number) => H - pad - ((v - lo) / (hi - lo)) * (H - pad * 2);
  const xy = pts.map((p, i) => [X(ts[i]), Y(p[1])] as const);
  const line = xy.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join('');
  const step = xy.map(([x, y], i) => (i ? `H${x.toFixed(1)}V${y.toFixed(1)}` : `M${x.toFixed(1)} ${y.toFixed(1)}`)).join('');
  const zero = Math.min(H - pad, Math.max(pad, Y(Math.max(lo, Math.min(0, hi)))));
  const norm = vs.map((v) => (v - lo) / (hi - lo));
  return { xy, line, step, zero, norm, lo, hi, ex: X(Date.parse('2022-05-23')) };
}

const cards = SET.flatMap(([id, form]) => {
  if (id === 'renewables-82') return rn ? [{ id, form, href: url('targets/#renewables-82'), title: 'Renewables: 82% by 2030', now: `${rn.share}%`, v: rn.share, g: null }] : [];
  const m = byId(id); if (!m) return [];
  const g = geometry(m); if (!g && !PICTURE.includes(form)) return [];
  return [{ id, form, href: url(`measures/${m.id}/`), title: m.title, now: headlineText(m.headline), v: m.headline.value, g }];
});
const arc = (cx: number, cy: number, r: number, a0: number, a1: number) => { const p = (a: number) => [cx + r * Math.cos(a), cy + r * Math.sin(a)]; const [x0, y0] = p(a0), [x1, y1] = p(a1); return `M${x0.toFixed(1)} ${y0.toFixed(1)}A${r} ${r} 0 ${a1 - a0 > Math.PI ? 1 : 0} 1 ${x1.toFixed(1)} ${y1.toFixed(1)}`; };
const TAU = Math.PI * 2;
---
<div class="orbit" data-orbit>
  <div class="orbit-sphere" aria-hidden="true"></div>
  <ul class="orbit-ring" aria-label="A selection of measures">
    {cards.map(({ href, title, g, form, now, v }, i) => (
      <li class="orbit-item" style={`--n:${i};--count:${cards.length}`}>
        <span class="orbit-back" aria-hidden="true"></span>
        <a href={href} class="orbit-card" aria-label={`${title}: now ${now}`}>
          <span class="orbit-title">{title}</span>
          <span class="orbit-now">{now}</span>
          <svg viewBox={`0 0 ${W} ${H}`} class="orbit-chart" aria-hidden="true" preserveAspectRatio={PICTURE.includes(form) ? 'xMidYMid meet' : 'none'}>
            {!PICTURE.includes(form) && !['slope', 'heat', 'radial'].includes(form) && <line x1={g!.ex} x2={g!.ex} y1="0" y2={H} class="orbit-election" />}
            {form === 'line' && <><path d={g!.line} class="orbit-line" /><circle cx={g!.xy[g!.xy.length - 1][0]} cy={g!.xy[g!.xy.length - 1][1]} r="3" class="orbit-end" /></>}
            {form === 'area' && <><path d={`${g!.line}L${g!.xy[g!.xy.length - 1][0].toFixed(1)} ${H}L${g!.xy[0][0].toFixed(1)} ${H}Z`} class="orbit-fill" /><path d={g!.line} class="orbit-line" /><circle cx={g!.xy[g!.xy.length - 1][0]} cy={g!.xy[g!.xy.length - 1][1]} r="3" class="orbit-end" /></>}
            {form === 'bars' && g!.xy.map(([x, y]) => <rect x={x - Math.max(0.8, (W / g!.xy.length) * 0.6) / 2} y={Math.min(y, g!.zero)} width={Math.max(0.8, (W / g!.xy.length) * 0.6)} height={Math.max(0.6, Math.abs(g!.zero - y))} class="orbit-bar" />)}
            {form === 'scatter' && <>{g!.xy.map(([x, y], k) => <circle cx={x} cy={y} r={1.4 + g!.norm[k] * 2.2} class="orbit-dot" style={`opacity:${(0.35 + g!.norm[k] * 0.6).toFixed(2)}`} />)}<circle cx={g!.xy[g!.xy.length - 1][0]} cy={g!.xy[g!.xy.length - 1][1]} r="3.4" class="orbit-end" /></>}
            {form === 'step' && <><path d={g!.step} class="orbit-line orbit-line-2" /><circle cx={g!.xy[g!.xy.length - 1][0]} cy={g!.xy[g!.xy.length - 1][1]} r="3" class="orbit-end" /></>}
            {form === 'lollipop' && g!.xy.filter((_, k) => k % 3 === 0 || k === g!.xy.length - 1).map(([x, y], k, arr) => <><line x1={x} x2={x} y1={H - pad} y2={y} class="orbit-stem" /><circle cx={x} cy={y} r={k === arr.length - 1 ? 3 : 2} class={k === arr.length - 1 ? 'orbit-end' : 'orbit-dot'} /></>)}
            {form === 'slope' && (() => { const a = g!.xy[Math.max(0, g!.xy.findIndex(([x]) => x >= g!.ex))], b = g!.xy[g!.xy.length - 1]; const y0 = H - pad - ((g!.norm[Math.max(0, g!.xy.findIndex(([x]) => x >= g!.ex))]) * (H - pad * 2)), y1 = H - pad - g!.norm[g!.norm.length - 1] * (H - pad * 2); return <><line x1="22" x2="22" y1={pad} y2={H - pad} class="orbit-axis" /><line x1={W - 22} x2={W - 22} y1={pad} y2={H - pad} class="orbit-axis" /><line x1="22" y1={y0} x2={W - 22} y2={y1} class="orbit-line orbit-line-3" /><circle cx="22" cy={y0} r="3" class="orbit-dot" /><circle cx={W - 22} cy={y1} r="3.4" class="orbit-end" /><text x="22" y={H - 1} class="orbit-tick" text-anchor="middle">2022</text><text x={W - 22} y={H - 1} class="orbit-tick" text-anchor="middle">now</text></>; })()}
            {form === 'heat' && g!.norm.map((n, k) => <rect x={pad + (k / g!.norm.length) * (W - pad * 2)} y={10} width={(W - pad * 2) / g!.norm.length + 0.4} height={H - 20} class="orbit-cell" style={`opacity:${(0.12 + n * 0.88).toFixed(2)}`} />)}
            {form === 'donut' && <><circle cx={W / 2} cy={H / 2} r="19" class="orbit-track" /><path d={arc(W / 2, H / 2, 19, -Math.PI / 2, -Math.PI / 2 + (v / 100) * TAU)} class="orbit-arc" /><text x={W / 2} y={H / 2 + 4} class="orbit-label" text-anchor="middle">{Math.round(v)}%</text></>}
            {form === 'gauge' && <><path d={arc(W / 2, H - 6, 34, Math.PI, TAU)} class="orbit-track" /><path d={arc(W / 2, H - 6, 34, Math.PI, Math.PI + Math.min(1, v / 100) * Math.PI)} class="orbit-arc" /><text x={W / 2} y={H - 8} class="orbit-label" text-anchor="middle">{Math.round(v)}%</text><text x={W / 2} y={H - 1} class="orbit-tick" text-anchor="middle">of pace needed</text></>}
            {form === 'pictogram' && <>
              <g class="orbit-house" transform="translate(18 8)"><path d="M0 16 L16 2 L32 16 V36 H0 Z" /><rect x="12" y="24" width="8" height="12" class="orbit-door" /></g>
              {[0, 1, 2].map((k) => <g class="orbit-person" transform={`translate(${70 + k * 24} 10)`}><clipPath id={`pp${k}`}><rect x="0" y="0" width={24 * Math.max(0, Math.min(1, v - k))} height="40" /></clipPath><g clip-path={`url(#pp${k})`}><circle cx="9" cy="6" r="5" /><path d="M0 36 V20 a9 9 0 0 1 18 0 V36 Z" /></g><g class="orbit-person-ghost"><circle cx="9" cy="6" r="5" /><path d="M0 36 V20 a9 9 0 0 1 18 0 V36 Z" /></g></g>)}
            </>}
            {form === 'houses' && accord && (() => { const per = 40000, cols = 10, rows = 3, n = cols * rows; const built = Math.round(accord.built / per), pace = Math.round(accord.dueByNow / per); const cw = (W - pad * 2) / cols, ch = (H - pad * 2) / rows; return Array.from({ length: n }, (_, k) => { const c = k % cols, r = Math.floor(k / cols); const cls = k < built ? 'orbit-h-built' : k < pace ? 'orbit-h-gap' : 'orbit-h-todo'; return <path transform={`translate(${(pad + c * cw + 0.5).toFixed(1)} ${(pad + r * ch + 0.5).toFixed(1)}) scale(${((cw - 1) / 32).toFixed(3)})`} d="M5 15 L16 5 L27 15 V27 H5 Z" class={cls} />; }); })()}
            {form === 'people' && Array.from({ length: 10 }, (_, k) => { const f = Math.max(0, Math.min(1, v / 10 - k)); const x = pad + 2 + k * ((W - pad * 2 - 4) / 10); return <g transform={`translate(${x.toFixed(1)} 8)`}><clipPath id={`bb${k}`}><rect x="0" y="0" width={11 * f} height="40" /></clipPath><g class="orbit-person-ghost"><circle cx="5.5" cy="5" r="4" /><path d="M0 34 V16 a5.5 5.5 0 0 1 11 0 V34 Z" /></g><g class="orbit-person" clip-path={`url(#bb${k})`}><circle cx="5.5" cy="5" r="4" /><path d="M0 34 V16 a5.5 5.5 0 0 1 11 0 V34 Z" /></g></g>; })}
            {form === 'goal' && (() => { const x0 = pad + 4, x1 = W - pad - 4, y = H / 2 + 4; const X = (p: number) => x0 + (x1 - x0) * Math.min(1, p / 50); return <><line x1={x0} x2={x1} y1={y} y2={y} class="orbit-goal-track" /><line x1={x0} x2={X(v)} y1={y} y2={y} class="orbit-goal-fill" /><circle cx={X(v)} cy={y} r="4" class="orbit-end" /><line x1={X(emisTarget)} x2={X(emisTarget)} y1={y - 13} y2={y + 9} class="orbit-goal-flag" /><path d={`M${X(emisTarget)} ${y - 13} h11 l-3 4 l3 4 h-11 z`} class="orbit-goal-flagfill" /><text x={X(emisTarget)} y={y + 19} class="orbit-tick" text-anchor="middle">{emisTarget}% by 2030</text><text x={X(v)} y={y - 8} class="orbit-tick" text-anchor="middle">{Math.round(v)}% now</text></>; })()}
            {form === 'crowd' && cr && Array.from({ length: 11 }, (_, k) => <g transform={`translate(${(pad + 2 + k * 13.2).toFixed(1)} 10)`} class={k < 10 ? 'orbit-pp-then' : 'orbit-pp-new'}><circle cx="5.5" cy="5" r="4" /><path d="M0 34 V16 a5.5 5.5 0 0 1 11 0 V34 Z" /></g>)}
            {form === 'crowd' && cr && <text x={W / 2} y={H - 1} class="orbit-tick" text-anchor="middle">for every 10 in work in 2022, now 11</text>}
            {form === 'days' && md && Array.from({ length: 22 }, (_, k) => { const c = k % 11, r = Math.floor(k / 11), f = Math.max(0, Math.min(1, md.days - k)); const x = pad + c * 13.4, y = 6 + r * 19; return <g><rect x={x} y={y} width="11.5" height="16" rx="2" class="orbit-day" />{f > 0 && <rect x={x} y={y} width={11.5 * f} height="16" rx="2" class="orbit-day-on" />}</g>; })}
            {form === 'days' && md && <text x={W / 2} y={H - 1} class="orbit-tick" text-anchor="middle">{md.days.toFixed(1)} days of pay a month</text>}
            {form === 'arrows' && pw && (() => { const base = 28, k = 0.066; return <><line x1="6" x2={W - 6} y1={base} y2={base} class="orbit-axis" /><path d={`M36 ${base}h16v${Math.abs(pw.promise) * k - 8}h6l-14 ${8}l-14 -8h6z`} class="orbit-promise" /><path d={`M98 ${base}h16v${-(pw.nsw * k - 8)}h6l-14 -8l-14 8h6z`} class="orbit-actual" /><text x="44" y={base - 6} class="orbit-tick" text-anchor="middle">−$275 promised</text><text x="106" y={base + 13} class="orbit-tick" text-anchor="middle">+${pw.nsw} actual</text></>; })()}
            {form === 'note' && wg && <><rect x="8" y="6" width={W - 16} height="18" rx="3" class="orbit-note" /><text x="14" y="19" class="orbit-label">$100</text><rect x="8" y="30" width={(W - 16) * wg.value / 100} height="18" rx="3" class="orbit-note" /><rect x={8 + (W - 16) * wg.value / 100} y="30" width={Math.max(2, (W - 16) * wg.lost / 100)} height="18" class="orbit-cut" /><text x="14" y="43" class="orbit-label">${wg.value.toFixed(2)}</text><text x={W - 12} y="19" class="orbit-tick" text-anchor="end">2022</text><text x={W - 14} y="43" class="orbit-tick" text-anchor="end">now</text></>}
            {form === 'coins' && nd && [{ p: nd.from, x: 50, c: 'orbit-coin-then' }, { p: nd.to, x: 100, c: 'orbit-coin-now' }].map(({ p, x, c }) => { const n = Math.round(p[1] / 4); return <g class={c}>{Array.from({ length: n }, (_, k) => <ellipse cx={x} cy={H - 10 - k * 3.4} rx="14" ry="3.2" />)}<text x={x} y={H - 1} class="orbit-tick" text-anchor="middle">${p[1]}bn</text></g>; })}
            {form === 'waterline' && bw && (() => { const mx = Math.max(...bw.years.map((y) => Math.abs(y.p[1]))), mid = H / 2, n = bw.years.length, w = (W - 16) / n; return <><line x1="4" x2={W - 4} y1={mid} y2={mid} class="orbit-axis" />{bw.years.map((y, k) => { const h = (Math.abs(y.p[1]) / mx) * (mid - 4); const x = 8 + k * w + w * 0.2; return <rect x={x} y={y.p[1] >= 0 ? mid - h : mid} width={w * 0.6} height={Math.max(1, h)} class={y.estimate ? 'orbit-col-est' : y.p[0] < '2022-07-01' ? 'orbit-col-before' : y.p[1] >= 0 ? 'orbit-col-up' : 'orbit-col-down'} />; })}</>; })()}
            {form === 'sun' && rn && Array.from({ length: 50 }, (_, k) => { const a = -Math.PI / 2 + (k / 50) * Math.PI * 2, cx = W / 2, cy = H / 2; return <line x1={cx + 13 * Math.cos(a)} y1={cy + 13 * Math.sin(a)} x2={cx + 26 * Math.cos(a)} y2={cy + 26 * Math.sin(a)} class={k * 2 < rn.share ? 'orbit-ray-on' : k * 2 < rn.target ? 'orbit-ray-goal' : 'orbit-ray-off'} />; })}
            {form === 'radial' && g!.norm.filter((_, k) => k % 2 === 0).map((n, k, arr) => { const a = -Math.PI * 0.9 + (k / (arr.length - 1)) * Math.PI * 1.8, r0 = 7, r1 = 7 + 19 * n; return <line x1={W / 2 + r0 * Math.cos(a)} y1={H / 2 + r0 * Math.sin(a)} x2={W / 2 + r1 * Math.cos(a)} y2={H / 2 + r1 * Math.sin(a)} class="orbit-ray" />; })}
          </svg>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  /* A ring of curved screens around an invisible sphere, seen from just above eye level. Real 3D: every card is
     rotated around the ring's axis and pushed out to the ring's radius, the whole ring turns, and the far side
     shows the frosted backs of the screens through the glow. */
  .orbit { --r: clamp(150px, 19vw, 235px); --cw: calc(var(--r) * 0.58); --ch: calc(var(--cw) * 1.1); position: relative; width: 100%; height: calc(var(--ch) * 2.1); perspective: calc(var(--r) * 5); perspective-origin: 50% 30%; }
  .orbit-sphere { position: absolute; left: 50%; top: 50%; width: calc(var(--r) * 1.9); aspect-ratio: 1; translate: -50% -46%; border-radius: 50%; background: radial-gradient(circle at 50% 42%, rgb(70 120 255 / 0.55) 0%, rgb(40 70 200 / 0.3) 38%, rgb(20 30 90 / 0.12) 60%, transparent 72%); filter: blur(10px); }
  .orbit-ring { position: absolute; left: 50%; top: 50%; width: 0; height: 0; margin: 0; padding: 0; list-style: none; transform-style: preserve-3d; transform: rotateX(-12deg) rotateY(0deg); }
  .orbit-item { position: absolute; left: calc(var(--cw) / -2); top: calc(var(--ch) / -2); width: var(--cw); height: var(--ch); transform-style: preserve-3d; transform: rotateY(calc(var(--n) * (360deg / var(--count)))) translateZ(var(--r)); }
  .orbit-card, .orbit-back { position: absolute; inset: 0; border-radius: 14px; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .orbit-card { display: grid; grid-template-rows: auto auto 1fr; gap: 2px; padding: 11px 12px 9px; text-decoration: none; color: #eef3ff; background: linear-gradient(170deg, rgb(32 60 160 / 0.62), rgb(10 22 70 / 0.78)); border: 1.5px solid rgb(120 170 255 / 0.85); box-shadow: 0 0 0 1px rgb(40 80 220 / 0.5), 0 0 22px rgb(60 120 255 / 0.55), inset 0 0 28px rgb(60 120 255 / 0.25); transition: box-shadow 160ms ease, border-color 160ms ease; }
  .orbit-card::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(180deg, rgb(255 255 255 / 0.12), transparent 40%); pointer-events: none; }
  .orbit-card:hover, .orbit-card:focus-visible { border-color: #fff; box-shadow: 0 0 0 1px rgb(120 170 255 / 0.9), 0 0 34px rgb(90 150 255 / 0.9), inset 0 0 28px rgb(90 150 255 / 0.35); }
  .orbit-back { transform: rotateY(180deg); background: rgb(30 55 150 / 0.22); border: 1.5px solid rgb(120 170 255 / 0.35); box-shadow: 0 0 18px rgb(60 120 255 / 0.3); }
  .orbit-title { font-size: 11.5px; font-weight: 600; line-height: 1.25; color: rgb(220 230 255 / 0.85); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .orbit-now { font-family: var(--font-display); font-size: 22px; font-weight: 600; line-height: 1.05; font-variant-numeric: tabular-nums; color: #fff; text-shadow: 0 0 12px rgb(120 170 255 / 0.8); }
  /* The ring turns on its own. Hovering a screen holds it; Motion off, or reduced motion, leaves it still. */
  @media (prefers-reduced-motion: no-preference) {
    .orbit-ring { animation: orbit-turn 48s linear infinite; }
    .orbit:hover .orbit-ring { animation-play-state: paused; }
  }
  :global(html[data-motion="off"]) .orbit-ring { animation: none !important; }
  @keyframes orbit-turn { from { transform: rotateX(-12deg) rotateY(0deg); } to { transform: rotateX(-7deg) rotateY(-360deg); } }
  .orbit-chart { width: 100%; height: auto; align-self: end; margin-top: 6px; aspect-ratio: 150 / 54; }
  .orbit-election { stroke: rgb(200 220 255 / 0.8); stroke-width: 1; stroke-dasharray: 2 3; opacity: 0.8; vector-effect: non-scaling-stroke; }
  .orbit-line { fill: none; stroke: var(--aurora-1); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .orbit-fill { fill: var(--aurora-1); opacity: 0.22; }
  .orbit-bar { fill: var(--brand-glow); opacity: 0.85; }
  .orbit-dot { fill: var(--aurora-3); opacity: 0.9; }
  .orbit-end { fill: #fff; stroke: #0a1a4a; stroke-width: 1.5; }
  .orbit-line-2 { stroke: var(--brand-glow); }
  .orbit-line-3 { stroke: var(--aurora-3); stroke-width: 2.5; }
  .orbit-stem { stroke: var(--brand-glow); stroke-width: 1.2; opacity: 0.7; vector-effect: non-scaling-stroke; }
  .orbit-axis { stroke: rgb(255 255 255 / 0.18); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .orbit-tick, .orbit-label { font-family: var(--font-sans); fill: var(--on-night-2); font-size: 7.5px; font-weight: 600; }
  .orbit-label { fill: #fff; font-size: 11px; font-weight: 700; }
  .orbit-cell { fill: var(--aurora-3); }
  .orbit-track { fill: none; stroke: rgb(255 255 255 / 0.14); stroke-width: 6; }
  .orbit-arc { fill: none; stroke: var(--aurora-1); stroke-width: 6; stroke-linecap: round; }
  .orbit-house path { fill: var(--brand-glow); opacity: 0.9; } .orbit-door { fill: var(--night); }
  .orbit-person circle, .orbit-person path { fill: var(--aurora-1); }
  .orbit-person-ghost circle, .orbit-person-ghost path { fill: rgb(255 255 255 / 0.1); }
  .orbit-h-built { fill: var(--aurora-1); }
  .orbit-h-gap { fill: rgb(255 170 90 / 0.25); stroke: var(--aurora-3); stroke-width: 2; stroke-linejoin: round; }
  .orbit-h-todo { fill: rgb(255 255 255 / 0.06); stroke: rgb(255 255 255 / 0.28); stroke-width: 2; stroke-linejoin: round; }
  .orbit-goal-track { stroke: rgb(255 255 255 / 0.18); stroke-width: 6; stroke-linecap: round; }
