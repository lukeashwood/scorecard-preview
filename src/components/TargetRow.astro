---
import VerdictPill from './VerdictPill.astro';
import Evidence from './Evidence.astro';
import { url } from '../config/site';
import { headlineText, fmtMonth } from '../lib/format';
import type { Measure } from '../lib/types';
interface Props { m: Measure; i?: number }
const { m, i = 0 } = Astro.props;
const t = m.ed.target!;
---
<article class="card rise p-5 md:p-6" style={`--i:${i}`} id={`t-${m.id}`}>
  <div class="grid gap-4 md:grid-cols-[1fr_auto] md:items-center md:gap-8">
    <div>
      <p class="eyebrow">{t.ownerLabel}{t.deadline ? ` · due ${fmtMonth(t.deadline)}` : ''}</p>
      <a href={url(`measures/${m.id}/`)} class="mt-1.5 block font-display text-[21px] font-semibold leading-snug text-ink no-underline hover:text-brand">{t.commitment}</a>
      <p class="mt-2 text-[14.5px] text-ink-2">{m.verdict!.reason}</p>
    </div>
    <div class="flex items-center justify-between gap-5 md:flex-col md:items-end md:gap-2">
      <VerdictPill verdict={m.verdict!.verdict} label={t.verdictLabels?.[m.verdict!.verdict]} large />
      <p class="text-right"><span class="num font-display text-[26px] font-semibold leading-none">{headlineText(m.headline)}</span><span class="meta block max-w-[24ch]">{m.headline.caption}</span></p>
    </div>
  </div>
  <Evidence m={m} />
</article>
