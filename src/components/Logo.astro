---
/* The mark: three rising bars inside an outline of Australia. The outline is simplified from coastal waypoints
   (equal scale, Tasmania included); the bars are the record. Drawn once here so the header, footer, favicon and the
   particle version on the home page all share one shape. */
interface Props { size?: number; class?: string; title?: string }
const { size = 30, class: cls = '', title } = Astro.props;
export const MAINLAND = '35.2,16.9 41.0,20.0 47.8,10.6 57.7,13.4 63.6,26.8 68.1,16.4 70.4,9.3 74.9,18.4 77.9,25.0 80.1,31.1 85.8,36.7 88.5,41.5 95.0,51.9 95.5,54.7 93.9,62.3 90.1,68.1 87.1,77.2 79.2,81.3 75.8,79.3 72.7,80.8 65.9,78.5 60.2,72.7 54.8,70.4 50.1,63.8 44.4,62.0 33.1,64.1 23.9,68.1 15.1,70.9 8.5,69.4 9.9,63.3 8.1,55.2 4.2,48.3 5.1,43.0 6.2,37.4 11.7,34.7 16.4,33.6 20.7,32.4 24.5,27.8 26.1,23.8 29.7,20.7 31.3,19.2';
export const TASMANIA = '75.4,85.6 83.3,85.9 82.6,91.7 78.3,92.5 75.6,88.7';
---
<svg width={size} height={size} viewBox="0 0 100 100" class={cls} role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'}>
  {title && <title>{title}</title>}
  <polygon points={MAINLAND} fill="none" stroke="var(--brand)" stroke-width="5" stroke-linejoin="round" />
  <polygon points={TASMANIA} fill="none" stroke="var(--brand)" stroke-width="5" stroke-linejoin="round" />
  <g fill="var(--good)"><rect x="17.5" y="53.5" width="9" height="7.9" rx="2.2"/><rect x="29.5" y="40.4" width="9" height="17.2" rx="2.2"/><rect x="41.5" y="32.9" width="9" height="24.1" rx="2.2"/><rect x="53.5" y="33.1" width="9" height="29.9" rx="2.2"/><rect x="65.5" y="27.9" width="9" height="44.7" rx="2.2"/></g>
</svg>
