---
/* "Then vs now" card for the home page: the figure when the government took office beside the latest figure, with a
   line that draws itself when the card scrolls into view. Grey before May 2022, brand colour after, so the eye goes
   straight to this government's period. Every number comes from the same since-office comparison used site wide. */
import DirectionBadge from './DirectionBadge.astro';
import { url } from '../config/site';
import { fmtPeriod, inferFreq, withUnit } from '../lib/format';
import { ratedSeries, TODAY } from '../lib/measures';
import type { Measure, Point } from '../lib/types';
interface Props { m: Measure; i?: number }
const { m, i = 0 } = Astro.props;
const se = m.sinceElection!;
const rs = ratedSeries(m)!;

// Published actuals only, and a newer series (the monthly CPI began in 2025) is joined onto the long-running one so
// the line reaches back before the election and still ends on the latest figure.
const actual = (pts: Point[]) => pts.filter((p) => p[0] <= TODAY && (!m.chart.estimateFrom || p[0] < m.chart.estimateFrom));
let pts = actual(rs.points);
if (pts.length && pts[0][0] > '2022-06-30' && m.chart.series?.[0]) {
  const start = pts[0][0];
  pts = [...actual(m.chart.series[0].points).filter((p) => p[0] < start), ...pts];
}
pts = pts.filter((p) => p[0] >= '2018-01-01');

const freq = inferFreq(pts, m.chart.freq);
const isIndex = rs.unit === 'index';
const fmt = (v: number) => withUnit(v, rs.unit, rs.decimals, { compact: true }) + (rs.unit === '' && m.headline.suffix ? m.headline.suffix : '');
const thenLabel = fmtPeriod(se.from[0], freq);
const nowLabel = fmtPeriod(se.to[0], inferFreq(rs.points, m.chart.freq));
const caption = isIndex ? `Index, ${thenLabel} = 100` : rs.name.replace(/\s*\(.*?\)\s*/g, ' ').trim();

// Line geometry, drawn at build time.
const W = 300, H = 72, pad = 5;
const ELECTION = '2022-05-23';
const ts = pts.map((p) => Date.parse(p[0])), vs = pts.map((p) => p[1]);
let lo = Math.min(...vs), hi = Math.max(...vs); if (hi === lo) { hi += 1; lo -= 1; }
const t0 = ts[0], t1 = ts[ts.length - 1] || t0 + 1;
const X = (t: number) => pad + ((t - t0) / (t1 - t0 || 1)) * (W - pad * 2);
const Y = (v: number) => H - pad - ((v - lo) / (hi - lo)) * (H - pad * 2);
const ex = X(Date.parse(ELECTION));
const split = pts.findIndex((p) => p[0] >= '2022-05-01');
const path = (a: number, b: number) => pts.slice(a, b).map((p, k) => `${k ? 'L' : 'M'}${X(ts[a + k]).toFixed(1)} ${Y(p[1]).toFixed(1)}`).join('');
const before = split > 0 ? path(0, split + 1) : '';
const after = path(Math.max(0, split), pts.length);
const last = pts[pts.length - 1];
---
<a href={url(`measures/${m.id}/`)} class="tn card card-link rise flex flex-col" style={`--i:${i}`}>
  <div class="flex items-start justify-between gap-3 px-5 pt-5">
    <h3 class="h3">{m.title}</h3>
    <DirectionBadge change={{ trend: se.trend, tone: se.tone, label: se.label }} />
  </div>
  <div class="grid grid-cols-2 gap-4 px-5 pt-4">
    <div class="border-t border-rule pt-2.5">
      <p class="mono text-[11.5px] uppercase tracking-[0.06em] text-ink-3"><span class="block">Then</span>{thenLabel}</p>
      <p class="num mt-1 font-display text-[clamp(30px,4vw,38px)] leading-none text-ink-3">{isIndex ? '100' : fmt(se.from[1])}</p>
    </div>
    <div class="border-t-2 border-brand pt-2">
      <p class="mono text-[11.5px] uppercase tracking-[0.06em] text-brand"><span class="block">Now</span>{nowLabel}</p>
      <p class="num mt-1 font-display text-[clamp(30px,4vw,38px)] font-semibold leading-none">{fmt(se.to[1])}</p>
    </div>
  </div>
  <p class="meta px-5 pt-2">{caption}</p>
  {pts.length > 1 && (
    <div class="mt-auto px-3 pt-4">
      <svg class="tn-chart block w-full" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={`${m.title} since 2018. ${thenLabel}: ${isIndex ? '100' : fmt(se.from[1])}. ${nowLabel}: ${fmt(last[1])}.`}>
        <rect x={ex} y="0" width={W - pad - ex} height={H} fill="var(--brand-tint)" opacity="0.6" />
        <line x1={ex} x2={ex} y1="0" y2={H} stroke="var(--brand)" stroke-width="1" stroke-dasharray="3 3" vector-effect="non-scaling-stroke" />
        {before && <path class="tn-line" pathLength="1" d={before} fill="none" stroke="var(--rule-strong)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />}
        <path class="tn-line tn-line-2" pathLength="1" d={after} fill="none" stroke="var(--brand)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
      </svg>
      <div class="relative h-5 mono text-[10.5px] uppercase" aria-hidden="true">
        <span class="absolute left-0 top-1 text-ink-3">2018</span>
        <span class="absolute top-1 pl-1 text-brand" style={`left:${((ex / W) * 100).toFixed(1)}%`}>May 2022</span>
      </div>
    </div>
  )}
</a>

<style>
  .tn { overflow: hidden; padding-bottom: 8px; }
  .tn-chart { height: 72px; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tn .tn-line { stroke-dasharray: 1; stroke-dashoffset: 1; }
    :global(.js) .tn.is-drawn .tn-line { animation: tn-draw 1100ms var(--ease-out) forwards; }
    :global(.js) .tn.is-drawn .tn-line-2 { animation-delay: 650ms; animation-duration: 1300ms; }
    @keyframes tn-draw { to { stroke-dashoffset: 0; } }
  }
</style>

<script>
  // Draw each line the first time its card scrolls into view.
  const cards = document.querySelectorAll<HTMLElement>('.tn');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-drawn'); io.unobserve(e.target); }
    }, { threshold: 0.4 });
    cards.forEach((c) => io.observe(c));
  } else cards.forEach((c) => c.classList.add('is-drawn'));
</script>
