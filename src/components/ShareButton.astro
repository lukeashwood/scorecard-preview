---
/* Share a figure: uses the phone's share sheet where there is one, otherwise copies the text and link.
   The click handler lives once in Base.astro and works for every [data-share] button on the page. */
interface Props { text: string; href: string; label?: string; class?: string }
const { text, href, label = 'Share', class: cls = '' } = Astro.props;
---
<button type="button" class:list={['btn btn-ghost btn-sm', cls]} data-share data-text={text} data-url={href}>
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7M16 6l-4-4-4 4M12 2v13" /></svg>
  <span data-share-label>{label}</span>
</button>
