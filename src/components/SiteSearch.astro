---
/* Site search: one small index file, loaded the first time the box is used, searched in the browser as you type.
   Works for measures, promises, controversies, laws, explainers and the main tools. No server, no tracking. */
import { url } from '../config/site';
interface Props { class?: string; id?: string }
const { class: cls = '', id = 'site-search' } = Astro.props;
---
<div class:list={['sq relative', cls]} data-search data-index={url('search-index.json')} data-find={url('find/')}>
  <label class="sr-only" for={id}>Search the site</label>
  <div class="relative">
    <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-3" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
    <input id={id} type="search" class="input !min-h-[38px] !pl-9 !py-1.5 text-[14.5px]" placeholder="Search measures, promises, laws…" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls={`${id}-results`} />
  </div>
  <ul id={`${id}-results`} class="sq-results card absolute left-0 right-0 z-50 mt-1.5 hidden max-h-[60vh] overflow-y-auto p-1.5 shadow-card" role="listbox"></ul>
  <a href={url('find/')} class="sq-help meta mt-1 hidden text-[12.5px] no-underline hover:underline">Not sure what to search? Let us help you find it →</a>
</div>

<style is:global>
  .sq-results li a { display: grid; gap: 2px; padding: 8px 10px; border-radius: 8px; color: var(--ink); text-decoration: none; }
  .sq-results li a:hover, .sq-results li a[aria-selected="true"] { background: var(--panel); }
  .sq-results .t { font-weight: 600; font-size: 14.5px; line-height: 1.3; }
  .sq-results .s { font-size: 12.5px; color: var(--ink-3); }
  .sq-results .k { font-family: var(--font-mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--brand); }
</style>

<script is:inline>
  (function () {
    var cache = null, loading = null;
    function load(src) { if (cache) return Promise.resolve(cache); if (!loading) loading = fetch(src).then(function (r) { return r.json(); }).then(function (d) { cache = d; return d; }); return loading; }
    var KIND = { measure: 'Measure', promise: 'Promise', controversy: 'Controversy', law: 'Law', lesson: 'Learn', page: 'Page' };
    document.querySelectorAll('[data-search]').forEach(function (root) {
      var input = root.querySelector('input'), list = root.querySelector('.sq-results'), sel = -1;
      function esc(s) { return s.replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
      function close() { list.hidden = true; list.classList.add('hidden'); input.setAttribute('aria-expanded', 'false'); sel = -1; }
      function render(items) {
        if (!items.length) { list.innerHTML = '<li class="px-3 py-2 text-[14px] text-ink-3">Nothing found. Try a shorter word.</li>'; }
        else list.innerHTML = items.map(function (i) { return '<li role="option"><a href="' + i.href + '"><span class="k">' + KIND[i.type] + '</span><span class="t">' + esc(i.title) + '</span><span class="s">' + esc(i.sub) + '</span></a></li>'; }).join('');
        list.hidden = false; list.classList.remove('hidden'); input.setAttribute('aria-expanded', 'true'); sel = -1;
        list.insertAdjacentHTML('beforeend', '<li class="border-t border-rule mt-1 pt-1"><a href="' + root.dataset.find + '"><span class="t">Not sure? Let us help you find it →</span></a></li>');
      }
      function search(q) {
        var words = q.toLowerCase().split(/\s+/).filter(Boolean); if (!words.length) { close(); return; }
        load(root.dataset.index).then(function (d) {
          var scored = d.map(function (i) {
            var t = i.title.toLowerCase(), s = 0;
            for (var k = 0; k < words.length; k++) { var w = words[k]; if (t.indexOf(w) === 0) s += 6; else if (t.indexOf(w) >= 0) s += 4; else if (i.text.indexOf(w) >= 0) s += 1; else return null; }
            if (i.type === 'measure' || i.type === 'promise') s += 1;
            return { i: i, s: s };
          }).filter(Boolean).sort(function (a, b) { return b.s - a.s; }).slice(0, 10).map(function (x) { return x.i; });
          render(scored);
        });
      }
      var t; input.addEventListener('input', function () { clearTimeout(t); t = setTimeout(function () { search(input.value); }, 80); });
      input.addEventListener('focus', function () { if (input.value.trim()) search(input.value); load(root.dataset.index); });
      input.addEventListener('keydown', function (e) {
        var opts = list.querySelectorAll('a'); if (!opts.length) return;
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); sel = e.key === 'ArrowDown' ? Math.min(sel + 1, opts.length - 1) : Math.max(sel - 1, 0); opts.forEach(function (o, k) { o.setAttribute('aria-selected', k === sel ? 'true' : 'false'); }); opts[sel].scrollIntoView({ block: 'nearest' }); }
        else if (e.key === 'Enter' && sel >= 0) { e.preventDefault(); location.href = opts[sel].href; }
        else if (e.key === 'Escape') close();
      });
      document.addEventListener('click', function (e) { if (!root.contains(e.target)) close(); });
    });
    document.addEventListener('keydown', function (e) { if ((e.metaKey || e.ctrlKey) && e.key === 'k') { var i = document.querySelector('[data-search] input'); if (i) { e.preventDefault(); i.focus(); } } });
  })();
</script>
