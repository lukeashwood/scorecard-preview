---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../config/site';
import { LESSONS } from '../../lib/learn';
import { MEASURES } from '../../lib/measures';
const glossary = MEASURES.filter((m) => m.explainer).slice(0, 40);
---
<Base title="The Australian economy explained in plain English" description="Short, interactive explainers on tax, the deficit and debt, inflation and interest rates, in plain English with no jargon. Free, with official figures." section="learn/">
  <div class="wrap pt-10 md:pt-14">
    <p class="eyebrow">Learn</p>
    <h1 class="display mt-2 text-[clamp(34px,4.6vw,52px)]">The economy, without the jargon</h1>
    <p class="lede mt-3">You don’t need an economics degree to follow how the country is going. Each of these takes two or three minutes and lets you move the numbers yourself.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {LESSONS.map((l, i) => (
        <a href={url(`learn/${l.slug}/`)} class="card card-link card-pad rise flex flex-col" style={`--i:${i}`}>
          <p class="eyebrow">Interactive · {l.minutes} min</p>
          <p class="mt-2 font-display text-[26px] font-semibold leading-tight">{l.title}</p>
          <p class="mt-2 text-[16px] text-ink-2">{l.question}</p>
          <p class="mt-5 inline-flex items-center gap-1.5 text-[14.5px] font-bold text-brand">Start <Icon name="arrow" size={15} /></p>
        </a>))}
    </div>
    <section class="mt-12">
      <h2 class="h2">More interactive tools</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[{ href: 'budget/build/', h: 'Build your own Federal Budget', p: 'Change any tax or spending line and see the deficit and debt respond.' },
          { href: 'calculator/', h: 'Are you better off?', p: 'Compare your take-home pay with 2022, after tax and inflation.' },
          { href: 'relationships/', h: 'Compare', p: 'See whether 2 official series move together, at the same time or later.' },
          { href: 'briefing/', h: 'Every measure in 3D', p: 'Every measure in one interactive 3D model.' }].map((t) => (
          <a href={url(t.href)} class="card card-link card-pad flex flex-col"><p class="font-display text-[20px] font-semibold leading-tight">{t.h}</p><p class="mt-2 text-[14.5px] text-ink-2">{t.p}</p><p class="mt-auto pt-4 inline-flex items-center gap-1.5 text-[14px] font-bold text-brand">Open <Icon name="arrow" size={14} /></p></a>))}
      </div>
    </section>
    <section class="mt-16">
      <h2 class="h2">Plain-English glossary</h2>
      <p class="mt-2 max-w-[70ch] text-ink-2">Every measure on the site comes with a short explanation of what it is and why it matters.</p>
      <dl class="mt-6 grid gap-x-10 gap-y-6 md:grid-cols-2">
        {glossary.map((m) => <div><dt class="font-bold"><a href={url(`measures/${m.id}/`)} class="text-ink no-underline hover:underline">{m.title}</a></dt><dd class="mt-1 text-[15px] text-ink-2">{m.explainer!.what}</dd></div>)}
      </dl>
    </section>
  </div>
</Base>
