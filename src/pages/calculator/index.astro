---
import Base from '../../layouts/Base.astro';
import HouseholdCalc from '../../islands/HouseholdCalc.tsx';
import { SITE, url } from '../../config/site';
import { byId, BUDGET } from '../../lib/measures';
import { RULES_2223, type TaxRules } from '../../lib/personalTax';
import { typicalHousehold, SRC } from '../../lib/typicalHousehold';

// Same inputs as the calculator on the home page: price and wage growth since the June quarter 2022, from the site's data.
const pvw = byId('prices_vs_wages')!;
const bar = (re: RegExp) => pvw.chart.bars?.find((x) => re.test(x.name))?.value ?? NaN;
const CPI = bar(/^All prices/), WPI = bar(/^Wages/);
const periodLabel = pvw.headline.period ?? '';
const mp = byId('mortgage')?.chart.series?.[0]?.points ?? [];
const mThen = mp.find((p) => p[0] === '2022-05-31'), mNow = mp[mp.length - 1];
const steps = byId('interest_rates')?.chart.series?.[0]?.points ?? [];
const cashAt = (d: string) => { const x = steps.filter((p) => p[0] <= d); return x.length ? x[x.length - 1][1] : null; };
const lift = mNow && cashAt(mNow[0]) != null && steps.length ? steps[steps.length - 1][1] - cashAt(mNow[0])! : 0;
const mortgage = mThen && mNow ? { then: mThen[1], now: mNow[1] + lift, thenLabel: 'May 2022', nowLabel: lift ? 'estimate after the latest rate decision' : new Date(mNow[0]).toLocaleString('en-AU', { month: 'long', year: 'numeric', timeZone: 'UTC' }) } : null;
const txNow = (BUDGET?.years ?? []).map((y: any) => y.tax_rates).find(Boolean);
const NOW_RULES: TaxRules | null = txNow ? { label: txNow.income_year.replace(/[–—]/g, '-'), brackets: txNow.brackets, medicareRate: txNow.medicare_levy, medicareLow: txNow.medicare_low, lito: txNow.lito } : null;
const TH = typicalHousehold(NOW_RULES);
const $ = (v: number) => (v < 0 ? '−' : '') + '$' + Math.round(Math.abs(v)).toLocaleString('en-AU');
const pageUrl = new URL(url('calculator/'), Astro.site).href;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Are you better off than in 2022? Cost of living calculator', url: pageUrl,
    applicationCategory: 'FinanceApplication', operatingSystem: 'Any', isAccessibleForFree: true, inLanguage: 'en-AU',
    description: 'Enter your income to compare your take-home pay today with the same job in 2022-23, after tax and inflation, using official ABS and ATO figures.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' }, publisher: { '@type': 'Organization', name: SITE.name, url: new URL(url(), Astro.site).href } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL(url(), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Are you better off?', item: pageUrl }] },
];
---
<Base title="Are you better off than in 2022? Cost of living calculator" description="Free calculator: are you better or worse off than in 2022-23 after tax and inflation? Plus a worked example for a typical household with a mortgage or rent." section="calculator/" jsonld={jsonld}>
  <div class="wrap pt-10 md:pt-14">
    <p class="eyebrow">Calculator</p>
    <h1 class="display mt-2 text-[clamp(34px,4.6vw,52px)]">Are you better off than in 2022?</h1>
    <p class="lede mt-3 max-w-[62ch]">Enter what you earn now, before tax. The calculator works out what the same job paid in 2022-23, takes out tax under each year’s rates, and compares the two in today’s dollars. Add your mortgage or rent to see the full picture.</p>
    {NOW_RULES && Number.isFinite(CPI) && Number.isFinite(WPI) && <div class="mt-6"><HouseholdCalc client:load then={RULES_2223} now={NOW_RULES} cpi={CPI} wpi={WPI} periodLabel={periodLabel} mortgage={mortgage} rentGrowth={TH?.rentGrowth} sittingRentGrowth={TH?.rents} /></div>}
    <noscript><p class="card card-pad mt-6">This calculator needs JavaScript. The worked example for a typical household is below.</p></noscript>
    <section class="mt-16" id="typical">
      <p class="eyebrow">Worked example</p>
      <h2 class="h2 mt-2">A typical household</h2>
      <p class="mt-2 max-w-[70ch] text-[15px] text-ink-2">The calculator above uses your own pay. This example takes a typical couple and adds their housing, groceries and car costs, so its figure is bigger and answers a different question.</p>
    {TH && (
      <div class="card mt-6 overflow-hidden shadow-card">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rule px-5 pt-5 pb-4 md:px-7">
          <div>
            <p class="eyebrow">A typical household, June 2022 and now</p>
            <h3 class="mt-1 font-display text-[24px] font-semibold leading-tight">A couple on the median wage, with a car and a weekly shop</h3>
            <p class="mt-1.5 max-w-[70ch] text-[14.5px] text-ink-2">This shows what has changed for the household, not who caused it. Interest rates are set by the independent Reserve Bank, fuel prices by world markets, and rents by the housing market.</p>
          </div>
          <div class="flex gap-1" role="tablist" aria-label="Home">
            <button type="button" role="tab" class="btn btn-sm btn-quiet" data-tenure="owner" aria-selected="true">Paying a mortgage</button>
            <button type="button" role="tab" class="btn btn-sm btn-quiet" data-tenure="renter" aria-selected="false">Renting</button>
          </div>
        </div>
        {([['owner', TH.owner, 'This household owns with a mortgage'], ['renter', TH.renter, 'This household rents']] as const).map(([k, V, note]) => (
          <div data-panel={k} hidden={k !== 'owner'}>
            <div class:list={['grid gap-2 px-5 py-5 md:grid-cols-[1fr_auto] md:items-center md:px-7', V.diff >= 0 ? 'bg-good-tint' : 'bg-bad-tint']}>
              <p class="text-[15px] font-semibold">{k === 'owner' ? `With the average new mortgage of $${Math.round(TH.loan / 1000)}k` : `Paying the median rent ($${Math.round(TH.rentWeek1)} a week now)`}</p>
              <p class="md:text-right"><span class:list={['num font-display text-[clamp(34px,5vw,46px)] font-semibold leading-none tracking-tight', V.diff >= 0 ? 'text-good' : 'text-bad']}>{$(Math.abs(V.diff))}</span> <span class:list={['font-bold', V.diff >= 0 ? 'text-good' : 'text-bad']}>a year {V.diff >= 0 ? 'better off' : 'worse off'} ({$(Math.abs(V.diff) / 52)} a week)</span></p>
            </div>
            <div class="table-scroll px-5 pb-2 pt-4 md:px-7">
              <table class="dt w-full">
                <thead><tr><th>A year</th><th class="r hidden sm:table-cell">June 2022</th><th class="r">Now</th><th class="r">Change</th></tr></thead>
                <tbody>
                  {V.rows.map((r) => <tr><td class="min-w-[120px] sm:min-w-[150px]"><b>{r.l}</b><span class="meta hidden sm:block">{r.n}</span></td><td class="r num hidden sm:table-cell">{$(r.a)}</td><td class="r num">{$(r.b)}</td><td class:list={['r num font-semibold', r.b - r.a >= 0 ? 'text-good' : 'text-bad']}>{(r.b - r.a >= 0 ? '+' : '') + $(r.b - r.a)}</td></tr>)}
                  <tr><td class="min-w-[120px] sm:min-w-[150px]"><b>Left for everything else</b><span class="meta hidden sm:block">{note}</span></td><td class="r num font-bold hidden sm:table-cell">{$(V.left0)}</td><td class="r num font-bold">{$(V.left1)}</td><td class="r num"></td></tr>
                  <tr><td class="min-w-[120px] sm:min-w-[150px]"><b>2022 amount in today’s prices</b><span class="meta hidden sm:block">Everything else costs {TH.cpi.toFixed(1)}% more (CPI, {TH.period})</span></td><td class="r num hidden sm:table-cell">{$(V.left0Today)}</td><td class="r num">{$(V.left1)}</td><td class:list={['r num font-bold', V.diff >= 0 ? 'text-good' : 'text-bad']}>{(V.diff >= 0 ? '+' : '') + $(V.diff)}</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        ))}
        <details class="px-5 pb-6 md:px-7"><summary class="cursor-pointer text-[14.5px] font-bold text-brand">How we worked this out</summary><p class="meta mt-3 max-w-[90ch]">Pay: ABS median weekly earnings, all employees, <a href={SRC.earnings2022}>August 2022</a> (${TH.weekly0.toLocaleString('en-AU')} a week each), grown by the Wage Price Index to the latest quarter (about ${Math.round(TH.weekly1).toLocaleString('en-AU')} a week each). The ABS has published no median household income since 2019-20 (<a href={SRC.sih}>the later surveys were cancelled or withheld</a>), so the household is 2 median earners. Mortgage: ABS <a href={SRC.lending}>average new owner-occupier loan</a>, June quarter 2022; RBA average variable rate on existing loans, May 2022 and {new Date(TH.rateMonth + 'T00:00:00Z').toLocaleString('en-AU', { month: 'long', year: 'numeric', timeZone: 'UTC' })}{TH.lift ? `, plus ${TH.lift.toFixed(2)} points of cash rate rises announced since, assumed passed on in full` : ''}. Rent: Cotality national median rent, all dwellings, <a href={SRC.rentNow}>$705 a week in the June quarter 2026</a>, against about ${Math.round(TH.rentWeek0)} in the June quarter 2022 (<a href={SRC.rent2022}>$544 in the September quarter 2022</a>, less that quarter’s 2.3% rise). That is what a new lease costs. The ABS rent index, which averages all existing leases including public housing, rose less ({TH.rents.toFixed(1)}%), so a renter who has stayed put may be doing a little better than this. Spending: ABS <a href={SRC.hes}>Household Expenditure Survey</a> 2015-16 averages (groceries $162, petrol $38, car registration and insurance $36.80 a week), brought to 2022 and to now with the matching <a href={SRC.cpi}>CPI</a> price indexes. Fuel is the June quarter; pump prices jumped again in August 2026. Home, health and life insurance are left in “everything else”. Interest rates are set by the independent Reserve Bank and fuel prices by world markets, so this shows what has changed for the household, not who caused each part. A guide, not financial advice.</p></details>
      </div>
    )}
    <script is:inline>
      (function () { var box = document.getElementById('typical'); if (!box) return; var tabs = box.querySelectorAll('[data-tenure]');
        function show(k) { tabs.forEach(function (t) { var on = t.dataset.tenure === k; t.setAttribute('aria-selected', String(on)); t.style.background = on ? 'var(--ink)' : ''; t.style.color = on ? 'var(--paper)' : ''; });
          box.querySelectorAll('[data-panel]').forEach(function (p) { p.hidden = p.dataset.panel !== k; }); }
        tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tenure); }); }); show('owner'); })();
    </script>
    </section>

    <section class="mt-16 grid gap-10 lg:grid-cols-2">
      <div class="prose"><h2 class="!mt-0">How the calculator works</h2>
        <p>Your pay in 2022-23 is estimated from what you earn now, using the ABS Wage Price Index, which tracks how much pay for the same job has grown. Income tax and the Medicare levy are worked out under the ATO’s resident rates for each year, including the low income tax offset. The result is then adjusted for inflation using the Consumer Price Index{periodLabel ? ` (${periodLabel})` : ''}, so both years are in today’s dollars.</p>
        <p>If you add a mortgage, the change in repayments uses the Reserve Bank’s average variable rate. If you rent, the change uses market rents for new leases.</p></div>
      <div class="prose"><h2 class="!mt-0">What it leaves out</h2>
        <ul><li>HELP repayments, super, government payments and most rebates and offsets.</li>
          <li>Any pay rise from a promotion or new job. It compares the same job in both years.</li>
          <li>Your own spending pattern. Inflation is the average for all households.</li></ul>
        <p>It is a guide, not financial advice. For the figures behind it, see <a href={url('measures/prices_vs_wages/')}>prices vs wages</a>, <a href={url('measures/inflation/')}>inflation</a>, <a href={url('measures/real_wages/')}>real wages</a> and <a href={url('measures/mortgage/')}>mortgage costs</a>. To try your own answer to the Budget, use the <a href={url('budget/build/')}>Federal Budget simulator</a>.</p></div>
    </section>
  </div>
</Base>
