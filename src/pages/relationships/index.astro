---
/* Pairs of official series shown together. Everything is calculated from the site's own data at build time. */
import Base from '../../layouts/Base.astro';
import RelationshipChart, { describe } from '../../islands/RelationshipChart.tsx';
import { PAIR_DATA } from '../../lib/relationships';
import { url } from '../../config/site';
import { GENERATED_AT } from '../../lib/measures';
import { fmtStamp } from '../../lib/format';
const TERM = '2022-07-01';
---
<Base title="Connections" description="Official figures side by side: government spending and inflation, migration and home prices, interest rates and inflation, and more. See how closely they move together." section="relationships/">
  <div class="wrap pt-10 md:pt-14">
    <p class="eyebrow">Connections · why did it happen?</p>
    <h1 class="display mt-2 text-[clamp(34px,4.6vw,52px)]">Do these move together?</h1>
    <p class="lede mt-3">Each chart puts two official series side by side, so you can see whether one rises when the other does, at the same time or a year or two later. The number <b>r</b> sums up how closely they track each other.</p>
    <div class="card card-pad mt-6 max-w-[860px] bg-panel" style="border-color:transparent">
      <p class="h3">Read these with care</p>
      <p class="mt-1.5 text-[15px] text-ink-2">Two things moving together does not prove one causes the other. Most of these are also driven by things not shown, such as world energy prices, the pandemic, or interest rates. Each chart says what else is at play. Use them as a starting point for questions, not as proof.</p>
    </div>
    <p class="meta mono mt-4">Figures as at {fmtStamp(GENERATED_AT)}</p>

    <nav class="mt-6 flex flex-wrap gap-1.5" aria-label="Jump to">{PAIR_DATA.map((p) => <a class="btn btn-quiet btn-sm" href={`#${p.spec.id}`}>{p.spec.title}</a>)}</nav>

    <div class="mt-10 grid gap-8">
      {PAIR_DATA.map((p) => { const best = p.byLag[0]; return (
        <article class="card card-pad scroll-mt-24" id={p.spec.id}>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0 max-w-[70ch]">
              <h2 class="h2 !text-[24px]">{p.spec.title}</h2>
              <p class="lede mt-1 !text-[17px]">{p.spec.question}</p>
            </div>
            <span class="pill pill-neutral">{describe(best.r).replace(/^\w/, (c) => c.toUpperCase())} at the same time</span>
          </div>
          <div class="mt-5">
            <RelationshipChart client:visible title={p.spec.title} freq={p.spec.freq} x={p.spec.x} y={p.spec.y} xSeries={p.x} ySeries={p.y} byLag={p.byLag} term={TERM} />
          </div>
          <h3 class="h3 mt-6">What else is going on</h3>
          <p class="prose mt-1.5 max-w-[80ch]">{p.spec.read}</p>
          <p class="meta mt-3">From the site’s own series: {p.hasPages.x ? <a href={url(`measures/${p.spec.x.measure}/`)}>{p.spec.x.label}</a> : p.spec.x.label} and {p.hasPages.y ? <a href={url(`measures/${p.spec.y.measure}/`)}>{p.spec.y.label}</a> : p.spec.y.label}. Sources are listed on each measure’s page.</p>
        </article>); })}
    </div>
  </div>
</Base>
