---
import Base from '../layouts/Base.astro';
import Briefing, { type BMeasure } from '../islands/Briefing.tsx';
import '../styles/hud.css';
import { url } from '../config/site';
import { MEASURES, SECTIONS, GENERATED_AT, tally, byId, record } from '../lib/measures';
import { SITE } from '../config/site';
import { fmtDate, headlineText } from '../lib/format';
import { INFLUENCE_LABEL, VERDICT_LABEL, VERDICT_TONE } from '../lib/editorial';

const toB = (m: (typeof MEASURES)[number]): BMeasure => ({ id: m.id, title: m.title, value: headlineText(m.headline), caption: m.headline.caption, period: m.headline.period ?? '', trend: m.sinceElection?.trend ?? null, tone: m.sinceElection?.tone ?? 'neutral', change: m.sinceElection?.label ?? '', span: m.sinceElection?.periodLabel ?? '', year: m.direction?.changeLabel ?? '', influence: INFLUENCE_LABEL[m.ed.influence], note: m.ed.baselineNote ?? '', verdict: m.verdict ? (m.ed.target?.verdictLabels?.[m.verdict.verdict] ?? VERDICT_LABEL[m.verdict.verdict]) : '', verdictTone: m.verdict ? VERDICT_TONE[m.verdict.verdict] : '', commitment: m.ed.target?.commitment ?? '', question: m.question, href: url(`measures/${m.id}/`) });
const topics = SECTIONS.map((s) => ({ id: s.id, title: s.title, blurb: s.blurb, measures: MEASURES.filter((m) => m.section === s.id && m.ed.group !== 'context').map(toB) })).filter((t) => t.measures.length);
const moved = MEASURES.filter((m) => m.sinceElection && m.sinceElection.tone !== 'neutral');
// rank by the size of the move relative to where it started, so rates and levels can be compared
const size = (m: (typeof MEASURES)[number]) => Math.abs((m.sinceElection!.to[1] - m.sinceElection!.from[1]) / (Math.abs(m.sinceElection!.from[1]) || 1));
const better = moved.filter((m) => m.sinceElection!.tone === 'good').sort((a, b) => size(b) - size(a)).slice(0, 4).map(toB);
const worse = moved.filter((m) => m.sinceElection!.tone === 'bad').sort((a, b) => size(b) - size(a)).slice(0, 4).map(toB);
const due = MEASURES.filter((m) => m.recheck_by).sort((a, b) => a.recheck_by!.localeCompare(b.recheck_by!)).slice(0, 5).map((m) => ({ title: m.title, date: fmtDate(m.recheck_by!), href: url(`measures/${m.id}/`) }));
const t = tally();
const rec = record();
const dir = (m: BMeasure) => (m.tone === 'good' ? 'better' : m.tone === 'bad' ? 'worse' : m.trend === 'up' ? 'higher' : m.trend === 'down' ? 'lower' : 'little changed');
const phrase = (m: BMeasure) => `${m.title} is ${m.value}, ${dir(m)} by ${m.change.replace(/^[+−]/, '')}`;
const steps = [
  { target: -1, say: `This is the Scorecard briefing on the ${SITE.government.name}, using official figures as at ${fmtDate(GENERATED_AT)}. Since it took office in May 2022, ${rec.better.length} of ${rec.total} key measures are better and ${rec.worse.length} are worse. Of ${t.total} measurable promises, ${t.good} are met or on track, ${t.risk} are at risk, and ${t.bad} are off track or not met.` },
  ...topics.map((tp, i) => {
    const movers = tp.measures.filter((m) => m.change).sort((a, b) => (a.tone === 'neutral' ? 1 : 0) - (b.tone === 'neutral' ? 1 : 0)).slice(0, 3);
    const promises = tp.measures.filter((m) => m.verdict);
    return { target: i, say: `${tp.title}. ${movers.length ? 'Since May 2022: ' + movers.map(phrase).join('; ') + '.' : ''}${promises.length ? ' Promises here: ' + promises.map((m) => `${m.title}, ${m.verdict.toLowerCase()}`).join('; ') + '.' : ''}` };
  }),
  { target: -1, say: 'That is the briefing. Select any sphere or moon for the detail, and every figure links to its official source.' },
];
---
<Base title="The briefing" description="A live command-centre view of every measure: what moved, what's due, and a spoken daily briefing generated from official figures." section="briefing/">
  <h1 class="sr-only">The daily briefing</h1>
  <Briefing client:only="react" topics={topics} tally={t} record={{ better: rec.better.length, worse: rec.worse.length, steady: rec.steady.length, total: rec.total }} moves={{ better, worse }} due={due} steps={steps} asAt={fmtDate(GENERATED_AT)} since="May 2022" government={SITE.government.name} targetsHref={url('targets/')} />
  <noscript><p class="wrap py-10">The briefing needs JavaScript. Every figure is also on the <a href={url('measures/')}>measures page</a>.</p></noscript>
</Base>
