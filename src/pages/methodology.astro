---
import Base from '../layouts/Base.astro';
import VerdictPill from '../components/VerdictPill.astro';
import { SITE, url } from '../config/site';
import { TARGETS, CONDITIONS, CHECKS } from '../lib/measures';
import { SECTIONS } from '../lib/measures';
import { VERDICT_MEANING, INFLUENCE_LABEL, INFLUENCE_MEANING } from '../lib/editorial';
import { fmtDate } from '../lib/format';
import type { Verdict } from '../lib/types';
const order: Verdict[] = ['met', 'on_track', 'in_progress', 'at_risk', 'off_track', 'not_met'];
const coloured = CONDITIONS.filter((m) => m.ed.better !== 'none'), neutral = CONDITIONS.filter((m) => m.ed.better === 'none');
/* Common questions, answered in the words of the sections above. Each answer restates something this page already says,
   so the FAQ and the FAQPage structured data below never claim more than the methodology does. */
const FAQ: { q: string; a: string }[] = [
  { q: 'Does Gov Score give the government an overall score or grade?', a: 'No. A verdict is given only where the government itself made a commitment with a number or a date in it that official statistics can test. Nothing else is given a verdict, and the verdicts are not added up into a single mark.' },
  { q: 'Where do the figures come from?', a: 'From official publishers: the Australian Bureau of Statistics, the Reserve Bank, the Treasury and Budget papers, the Australian Office of Financial Management and the agencies that run each program. International comparisons come from the IMF and the World Bank. The one exception is market rents for new leases, which no agency publishes; that figure comes from Cotality and is labelled as such. Every figure links to its source.' },
  { q: 'How often are the figures updated and checked?', a: 'A program re-fetches every automated series every day and tests it: whether the source is still reachable, whether the newest figure is inside a plausible range, whether it agrees with a second official source where one exists, and whether earlier figures have been revised. A failed check keeps the last verified figure on the page and marks it under review. Figures typed in from documents, commitments, verdict rules and controversy entries are checked by a person and show the date they were checked.' },
  { q: 'How is a promise judged kept or broken?', a: 'Each commitment has a published rule, listed in full on this page, that says which official figure it is tested against and what counts as delivered by when. The latest official figure is compared with that rule to give 1 of 6 verdicts: met, on track, in progress, at risk, off track or not met. Commentary from a minister, an institution or anyone else can sit beside a verdict to explain it, but it cannot change it.' },
  { q: 'What happens when the government changes or drops a target?', a: 'The original commitment stays on the site and is judged on its original terms: the same number and the same deadline. The new target is shown beside it with the date it changed and a link to the announcement. A changed target is not a met target.' },
  { q: 'Is Gov Score neutral?', a: 'No. Gov Score is a record of where the Albanese Government has fallen short on the economy and the Budget. Measures that have moved the government’s way, and social-policy measures, are not carried. Every figure it does show is official and linked to its source, so it can be checked.' },
  { q: 'What do "this term" and "since 2022" compare?', a: '"This term" compares the latest figure with where it was at the May 2025 election: May 2025 for monthly figures, the June quarter 2025 for quarterly figures and 2024-25 for annual ones. "Since 2022" compares it with when the government first took office: May 2022, the June quarter 2022 or 2021-22. Use the switch at the top of every page to change between them.' },
  { q: 'Can the figures, charts and tables be reused?', a: 'Yes. ABS and RBA material is used under Creative Commons Attribution 4.0, and this site’s own tables and calculations may be reused under the same licence: credit Gov Score and link to the page. Every measure page has a ready-made citation and a CSV download, and the data page has everything in one file.' },
  { q: 'What happens if a figure on the site is wrong?', a: 'If a statistical agency revises a past figure, the site shows the revised series, because that is the official record. If the site makes a mistake of its own, in a figure, a calculation or a description, it is fixed and the fix is listed on the corrections page with the date and what changed.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="Methodology: how we check figures and verdicts" description="How figures are collected and checked, how verdicts are reached, and the full text of every rating rule." jsonld={faqLd} ogImage={url('share/page/methodology.png')} ogImageAlt="Gov Score methodology: how figures and verdicts are checked">
  <div class="wrap-narrow pt-10 md:pt-14">
    <p class="eyebrow">Methodology · rules v{SITE.rulesVersion} · {fmtDate(SITE.rulesDate)}</p>
    <h1 class="display mt-2 text-[clamp(34px,4.6vw,52px)]">How this site works</h1>
    <div class="prose mt-6">
      <p>This page is written from the same file the site’s code runs on, so what you read here is exactly what the site does. If a rule changes, the version number changes and the change is <a href={url('corrections/')}>logged in public</a>.</p>

      <h2>1. Where the figures come from</h2>
      <p>Figures come from official publishers: the Australian Bureau of Statistics, the Reserve Bank, the Treasury and Budget papers, the Australian Office of Financial Management, and the agencies that run each program. International comparisons come from the International Monetary Fund and the World Bank. Most series are fetched automatically from the publisher’s own data service. Where a figure exists only in a PDF (parts of the Budget, some agency reports), a person reads it from the document, records where it came from, and sets a date to check it again. Each measure’s page says which of the two applies.</p>
      <p>One figure is not official: market rents for new leases, which no government agency publishes. The household comparison uses Cotality’s national median rent for this and says so, alongside the ABS rent index for existing leases.</p>
      <p>Every figure links to its source. Every page shows the date of the latest data point and the date it was last checked, which are different things.</p>

      <h2 id="checks">2. What “checked” means</h2>
      <p>“Checked” is used on this site in two different senses, and it is worth being exact about both.</p>
      <p><b>Automated checks, every day.</b> A program re-fetches every automated series and tests it: is the source still reachable, is the newest figure inside a plausible range, does it agree with a second official source where one exists (for example the ABS and the Reserve Bank for inflation, unemployment and wages, and the AOFM’s register for government debt), have earlier figures been revised, and do Budget categories add up to the published totals. The latest run made {CHECKS.checks_total} checks: {CHECKS.checks_passed} passed, {CHECKS.checks_warn} raised a warning (usually a source that was slow to respond) and {CHECKS.checks_failed} failed. A failed check keeps the last verified figure on the page, marks it “under review” and alerts the publisher, rather than publishing a doubtful number. The 3 counts are published with every data run on the <a href={url('data/')}>data page</a>, and the <a href={url('data/checks/')}>check-by-check log</a> lists each test, what it found and whether it passed.</p>
      <p><b>Human checks, when sources change.</b> Figures typed in from documents, every commitment, every verdict rule, and every entry on the controversies page are checked by a person against the original source. Each shows the date it was checked and when it is next due. People do not review every automated daily update: the tests above do that job, and anything that fails them is held back for a person to look at.</p>
      <h2>3. Broken promises</h2>
      <p>A verdict is given only when three things are true: the government itself made the commitment, the commitment contains a number or a date, and official statistics can test it. Measuring a government against its own words is the one yardstick nobody can call unfair. Promises the government has already delivered are not listed.</p>
      <div class="table-scroll"><table><thead><tr><th>Verdict</th><th>Meaning</th></tr></thead><tbody>{order.map((v) => <tr><td><VerdictPill verdict={v} /></td><td>{VERDICT_MEANING[v]}</td></tr>)}</tbody></table></div>

      <h3 id="data-not-judgements">Institutions supply data, not judgements</h3>
      <p>Gov Score uses official figures from bodies such as the Australian Bureau of Statistics, the Reserve Bank and the Budget papers. It does not adopt any institution’s view of what those figures mean, or whether a result was reasonable in the circumstances. A result is set only by the commitment and the figures. Commentary, from an institution, a minister or anyone else, can sit beside a result to explain it, but it can never change it. Gov Score doesn’t judge whether a government had a good reason for missing a target; it records whether the target was met.</p>

      <h3 id="moved-targets">When a target is changed</h3>
      <p>If the government changes, delays, softens or drops a commitment after making it, the original commitment stays on this site and is judged on its original terms: the same number and the same deadline. The new target is shown beside it, with the date it changed and a link to the announcement, so readers can see both. A changed target is not a met target. The only exception is a commitment recorded here by mistake (one the government never actually made), which is removed and logged as a correction.</p>

      <h3>The rule for each commitment</h3>
      <div class="table-scroll"><table><thead><tr><th>Commitment</th><th>Rule</th></tr></thead><tbody>
        {TARGETS.map((m) => <tr><td><a href={url(`measures/${m.id}/`)}>{m.ed.target!.commitment}</a><br /><span class="meta">{m.ed.target!.ownerLabel}</span></td><td>{m.ed.target!.rule}</td></tr>)}
      </tbody></table></div>

      <h2 id="selection">4. Which measures are included</h2>
      <p>Every figure on this site is official. The choice of what to show is an editorial one: the site concentrates on the economy and the Budget, under {SECTIONS.length} topics: {SECTIONS.map((x) => x.title.toLowerCase()).join(', ')}. Measures that have moved the government’s way, and social-policy measures, are not carried.</p>
      <p>Each measure must still be official, published on a fixed schedule with a public method, and have enough history to compare the government’s period with what came before. Where more than one official series exists, the chart names the one used.</p>

      <h2>5. This term, and since 2022</h2>
      <p>Every measure can be compared 2 ways. <b>This term</b> starts from the May 2025 election: May 2025 for monthly figures, the June quarter 2025 for quarterly figures and 2024-25 for annual ones. <b>Since 2022</b> starts from when the government first took office: May 2022, the June quarter 2022 or 2021-22. The switch at the top of every page changes every comparison on the site, and charts have a “This term” view.</p>
      <p><strong>Better or worse</strong> colouring is used where the direction is clear: {coloured.map((m) => m.title.toLowerCase()).join(', ')}. For {neutral.map((m) => m.title.toLowerCase()).join(', ')}, the site says higher, lower or little changed.</p>
      <p><strong>Over the past year</strong> compares the latest figure with the same period a year earlier (the previous year for annual figures). A change smaller than 0.2 percentage points (for rates) or 1% (for levels and indexes) counts as little changed. Dollar figures that can go negative, such as the budget balance and net worth, are compared in dollars.</p>

      <h2>6. Whose doing is it?</h2>
      <p>Every measure carries one of three labels, with a sentence explaining why.</p>
      <ul>{(['direct', 'shared', 'indirect'] as const).map((k) => <li><strong>{INFLUENCE_LABEL[k]}.</strong> {INFLUENCE_MEANING[k]}</li>)}</ul>

      <h2>7. Revisions and corrections</h2>
      <p>Statistical agencies routinely revise past figures. When they do, the site shows the revised series, because that is the official record. If this site makes a mistake of its own, in a figure, a calculation or a description, it is fixed and the fix is listed on the <a href={url('corrections/')}>corrections page</a> with the date and what changed.</p>

      <h2>8. What this site doesn’t do</h2>
      <ul>
        <li>It doesn’t forecast. Budget forecasts are shown as the government’s own forecasts, shaded differently from actual results.</li>
        <li>It doesn’t publish figures from campaign material, media releases alone, or think tanks as if they were official statistics.</li>
      </ul>
      <h2>9. Reuse</h2>
      <p>ABS and RBA material is used under Creative Commons Attribution 4.0. This site’s own tables and calculations may be reused under the same licence: credit “{SITE.name}” and link to the page. Every measure page has a ready-made citation and a CSV download, the <a href={url('data/')}>data page</a> has everything in one file, and <a href={url('make-your-own-chart/')}>Make your own chart</a> walks through redrawing a chart in a spreadsheet and crediting it.</p>

      <h2 id="questions">10. Common questions</h2>
      {FAQ.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}
    </div>
  </div>
</Base>
