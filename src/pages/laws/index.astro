---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../config/site';
import { fmtDate } from '../../lib/format';
import raw from '../../data/laws.json';

interface Law { id: string; title: string; status: string; status_date: string; status_note: string; parliament_url: string; legislation_url: string | null; summary: string; verified_on: string;
  controversy?: { category: string; summary: string; raised_by?: string[]; sources?: { title: string; url: string }[] } | null }
const laws = (raw.laws as Law[]).map((l) => ({ ...l, sponsor: /private (member|senator)/i.test(l.status_note) ? 'private' : 'government' })).sort((a, b) => b.status_date.localeCompare(a.status_date));
const STATUS: Record<string, { label: string; tone: string }> = { scheduled: { label: 'Introduced', tone: 'neutral' }, debated: { label: 'Before Parliament', tone: 'brand' }, passed: { label: 'Passed', tone: 'good' }, failed: { label: 'Did not pass', tone: 'warn' }, repealed: { label: 'Repealed', tone: 'warn' } };
const counts = Object.keys(STATUS).map((k) => ({ k, n: laws.filter((l) => l.status === k && l.sponsor === 'government').length }));
const nPrivate = laws.filter((l) => l.sponsor === 'private').length;
---
<Base title="Laws" description="Significant bills before the Australian Parliament since May 2022: what each does, where it stands, and who raised what objections, all linked to the official record." section="laws/">
  <div class="wrap pt-10 md:pt-14">
    <p class="eyebrow">Laws · since May 2022</p>
    <h1 class="display mt-2 text-[clamp(34px,4.6vw,52px)]">What Parliament has passed, and what’s before it</h1>
    <p class="lede mt-3">A selection of significant bills, newest first. Each entry says in plain words what the bill does and where it stands, and links to Parliament’s own record. Where a bill drew organised objections, they’re reported with who raised them. That’s a record of the debate, not this site’s opinion.</p>

    <div class="no-print mt-7 grid gap-3 md:grid-cols-[1fr_auto] md:items-center">
      <div class="flex flex-wrap gap-2" id="law-status" role="group" aria-label="Filter by status">
        <button type="button" class="btn btn-sm btn-ghost" data-s="all" aria-pressed="true">All</button>
        {counts.map(({ k, n }) => <button type="button" class="btn btn-sm btn-ghost" data-s={k} aria-pressed="false">{STATUS[k].label} <span class="num text-ink-3">{n}</span></button>)}
      </div>
      <input type="search" id="law-q" class="input md:w-[260px]" placeholder="Search bills" aria-label="Search bills" />
    </div>
    <label class="no-print mt-3 inline-flex items-center gap-2.5 text-[14.5px] text-ink-2"><input type="checkbox" id="law-private" class="h-[18px] w-[18px] accent-[var(--brand)]" /> Also show {nPrivate} private members’ bills (introduced by crossbench or opposition MPs, not the government)</label>
    <p class="meta mt-3" id="law-count" role="status"></p>

    <ul class="mt-5 grid gap-4" id="law-list">
      {laws.map((l) => (
        <li class="card p-5 md:p-6" data-status={l.status} data-sponsor={l.sponsor} data-text={(l.title + ' ' + l.summary + ' ' + (l.controversy?.category ?? '')).toLowerCase()} hidden={l.sponsor === 'private'}>
          <div class="flex flex-wrap items-center gap-2">
            <span class={`pill pill-${STATUS[l.status]?.tone ?? 'neutral'}`}>{STATUS[l.status]?.label ?? l.status}</span>
            {l.sponsor === 'private' && <span class="pill pill-neutral">Private member’s bill</span>}
            <span class="meta mono">{fmtDate(l.status_date)}</span>
          </div>
          <h2 class="mt-2.5 font-display text-[22px] font-semibold leading-snug">{l.title}</h2>
          <p class="meta mt-1">{l.status_note}</p>
          <p class="mt-3 max-w-[80ch] text-[15.5px] text-ink-2">{l.summary}</p>
          {l.controversy && (
            <details class="mt-4 rounded-xl bg-panel p-4">
              <summary class="cursor-pointer text-[14.5px] font-bold">Points of debate · {l.controversy.category}{l.controversy.raised_by?.length ? ` · raised by ${l.controversy.raised_by.join(', ')}` : ''}</summary>
              <p class="mt-2.5 max-w-[80ch] text-[14.5px] text-ink-2">{l.controversy.summary}</p>
              {l.controversy.sources?.length ? <ul class="meta mt-2.5 grid gap-1">{l.controversy.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title} <Icon name="ext" size={12} class="inline" /></a></li>)}</ul> : null}
            </details>)}
          <p class="meta mt-4 flex flex-wrap gap-x-5 gap-y-1"><a href={l.parliament_url} rel="noopener">Parliament’s record <Icon name="ext" size={12} class="inline" /></a>{l.legislation_url && <a href={l.legislation_url} rel="noopener">Text of the law <Icon name="ext" size={12} class="inline" /></a>}<span>Checked {fmtDate(l.verified_on)}</span></p>
        </li>))}
    </ul>
    <div class="prose mt-14"><h2>How bills are chosen</h2><p>{raw.note} This is a selection of significant bills, not every bill. Government bills are shown by default because they show what the government is doing; private members’ bills almost never pass and are kept separate so they don’t distort the picture. Think one is missing or described unfairly? <a href={url('corrections/#report')}>Tell us</a>.</p></div>
  </div>
  <script is:inline>
    (function () { var items = [].slice.call(document.querySelectorAll('#law-list > li')), sb = document.querySelectorAll('#law-status [data-s]'), q = document.getElementById('law-q'), pv = document.getElementById('law-private'), ct = document.getElementById('law-count'), s = 'all';
      function paint() { var t = q.value.trim().toLowerCase(), n = 0; items.forEach(function (li) { var ok = (s === 'all' || li.dataset.status === s) && (pv.checked || li.dataset.sponsor === 'government') && (!t || li.dataset.text.indexOf(t) > -1); li.hidden = !ok; if (ok) n++; }); ct.textContent = n + (n === 1 ? ' bill' : ' bills') + ' shown'; }
      sb.forEach(function (b) { b.addEventListener('click', function () { s = b.dataset.s; sb.forEach(function (x) { var on = x === b; x.setAttribute('aria-pressed', String(on)); x.style.background = on ? 'var(--ink)' : ''; x.style.color = on ? 'var(--paper)' : ''; }); paint(); }); });
      q.addEventListener('input', paint); pv.addEventListener('change', paint); sb[0].style.background = 'var(--ink)'; sb[0].style.color = 'var(--paper)'; paint(); })();
  </script>
</Base>
