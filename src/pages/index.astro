---
import Base from '../layouts/Base.astro';
import TargetRow from '../components/TargetRow.astro';
import MeasureCard from '../components/MeasureCard.astro';
import VerdictPill from '../components/VerdictPill.astro';
import Icon from '../components/Icon.astro';
import { SITE, url } from '../config/site';
import { CONDITIONS, GOV_TARGETS, TARGETS, DELIVERIES, SECTIONS, CHECKS, GENERATED_AT, tally, record } from '../lib/measures';
import { headlineText } from '../lib/format';
import { VERDICT_TONE } from '../lib/editorial';
import { fmtStamp } from '../lib/format';
import HouseholdCalc from '../islands/HouseholdCalc.tsx';
import { byId, BUDGET } from '../lib/measures';
import { incomeTax, RULES_2122, RULES_2223, RULES_2526, type TaxRules } from '../lib/personalTax';
import MEDIAN from '../data/median-earnings.json';

const t = tally();
const rec = record();
const official = TARGETS.filter((m) => m.ed.target!.owner === 'official');
const groups = SECTIONS.map((s) => ({ ...s, items: CONDITIONS.filter((m) => m.section === s.id) })).filter((g) => g.items.length);
const segs = [
  { n: t.good, label: 'met or on track', color: 'var(--good)' },
  { n: t.progress, label: 'in progress', color: 'var(--ink-3)' },
  { n: t.risk, label: 'at risk', color: 'var(--warn)' },
  { n: t.bad, label: 'off track or not met', color: 'var(--bad)' },
].filter((s) => s.n > 0);
// ---- household calculator and median earner: price and wage growth since the June quarter 2022, from the site's data
const pvw = byId('prices_vs_wages')!;
const bar = (re: RegExp) => pvw.chart.bars?.find((x) => re.test(x.name))?.value ?? NaN;
const CPI = bar(/^All prices/), WPI = bar(/^Wages/);
const periodLabel = pvw.headline.period ?? '';
const mp = byId('mortgage')?.chart.series?.[0]?.points ?? [];
const mThen = mp.find((p) => p[0] === '2022-05-31'), mNow = mp[mp.length - 1];
const mortgage = mThen && mNow ? { then: mThen[1], now: mNow[1], thenLabel: 'May 2022', nowLabel: new Date(mNow[0]).toLocaleString('en-AU', { month: 'long', year: 'numeric', timeZone: 'UTC' }) } : null;
const txNow = (BUDGET?.years ?? []).map((y: any) => y.tax_rates).find(Boolean);
const NOW_RULES: TaxRules | null = txNow ? { label: txNow.income_year.replace('–', '-'), brackets: txNow.brackets, medicareRate: txNow.medicare_levy, medicareLow: txNow.medicare_low, lito: txNow.lito } : null;
// Median employee: ABS weekly median x 52, taxed under each year's rules; the August 2022 figure lifted to August 2025
// prices by chaining the three year-to-September CPI rises.
const infl = byId('inflation')!.chart.series![0].points;
const cpiR = MEDIAN.cpi_quarters.reduce((r, q) => { const p = infl.find((x) => x[0] === q); return p && r != null ? r * (1 + p[1] / 100) : null; }, 1 as number | null);
const med = (() => {
  if (cpiR == null) return null;
  const a0 = MEDIAN.then.weekly * 52, a1 = MEDIAN.now.weekly * 52;
  const net0 = a0 - incomeTax(a0, RULES_2223), net1 = a1 - incomeTax(a1, RULES_2526);
  return { a0, a1, net0, net1, real0: net0 * cpiR, diff: net1 - net0 * cpiR, cpiPct: (cpiR - 1) * 100 };
})();
const $ = (v: number) => (v < 0 ? '−' : '') + '$' + Math.round(Math.abs(v)).toLocaleString('en-AU');

const jsonld = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, description: SITE.description, url: new URL(url(), Astro.site).href };
---
<Base jsonld={jsonld}>
  <section class="border-b border-rule">
    <div class="wrap grid gap-10 py-12 md:py-16 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16">
      <div>
        <p class="eyebrow">{SITE.edition} · {SITE.government.name}</p>
        <h1 class="display mt-3 text-[clamp(38px,5.6vw,64px)]">Holding the government to account, <span class="text-brand">in its own numbers.</span></h1>
        <p class="lede mt-5">What the {SITE.government.name} promised, what it has delivered, and what has changed since it took office in May 2022. Every figure is official, linked to its source and checked every day. The facts are laid out plainly so you can judge for yourself.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="btn btn-primary" href="#record">See the record <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href="#commitments">Promises kept and broken</a>
        </div>
      </div>

      <div class="card card-pad shadow-card">
        <div class="flex items-baseline justify-between gap-3">
          <p class="eyebrow">Commitments tracker</p>
          <p class="meta mono">{fmtStamp(GENERATED_AT)}</p>
        </div>
        <p class="mt-3 font-display text-[22px] font-semibold leading-snug">{t.total} measurable commitments, judged on official figures.</p>
        <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[14px] text-ink-2">
          {segs.map((s) => <li class="inline-flex items-center gap-1.5"><span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-full" style={`background:${s.color}`} /><b class="num text-ink">{s.n}</b> {s.label}</li>)}
        </ul>
        <div class="mt-4 flex h-3 gap-[2px] overflow-hidden rounded-full" role="img" aria-label={segs.map((s) => `${s.n} ${s.label}`).join(', ')}>
          {segs.map((s) => <span style={`flex:${s.n};background:${s.color}`} />)}
        </div>
        <ul class="mt-4 grid gap-0">
          {[...GOV_TARGETS.map((m) => ({ href: url(`measures/${m.id}/`), title: m.title, verdict: m.verdict!.verdict })), ...DELIVERIES.map((d) => ({ href: url(`targets/#${d.id}`), title: d.title, verdict: d.verdict }))]
            .sort((a, b) => ['bad', 'warn', 'neutral', 'good'].indexOf(VERDICT_TONE[a.verdict]) - ['bad', 'warn', 'neutral', 'good'].indexOf(VERDICT_TONE[b.verdict])).slice(0, 7).map((x) => (
            <li class="rule-t first:border-t-0">
              <a href={x.href} class="flex items-center justify-between gap-3 py-2 text-[14.5px] font-semibold text-ink no-underline hover:text-brand"><span>{x.title}</span><VerdictPill verdict={x.verdict} /></a>
            </li>
          ))}
        </ul>
        <a href={url('targets/')} class="mt-2 inline-flex items-center gap-1.5 text-[14.5px] font-bold no-underline hover:underline">See all {t.total} commitments <Icon name="arrow" size={15} /></a>
        <p class="meta mt-3">Only commitments the government itself made are counted. <a href={url('methodology/')}>How verdicts work</a></p>
      </div>
    </div>
  </section>

  <section class="border-b border-rule bg-panel">
    <div class="wrap grid gap-x-8 gap-y-5 py-7 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { icon: 'ext', h: 'Every figure is sourced', p: 'Each number links to the official release it came from.' },
        { icon: 'shield', h: 'Checked every day', p: `${CHECKS.checks_total} automated checks ran on the latest update.` },
        { icon: 'scale', h: 'Verdicts only on real promises', p: 'No pass or fail on things the government never committed to.' },
        { icon: 'quote', h: 'Mistakes are published', p: 'Corrections are logged in public, with dates.' },
      ].map((x) => (
        <div class="flex gap-3">
          <span class="mt-0.5 text-brand"><Icon name={x.icon} size={20} /></span>
          <p class="text-[14.5px] leading-snug"><span class="block font-bold">{x.h}</span><span class="text-ink-2">{x.p}</span></p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap pt-16" id="record">
    <p class="eyebrow">The record · May 2022 to now</p>
    <h2 class="h2 mt-2">What has changed since the government took office</h2>
    {med && (
      <div class="card mt-6 grid gap-px overflow-hidden bg-rule sm:grid-cols-3" style="border-color:var(--rule)">
        <div class="bg-surface p-5"><p class="eyebrow">Median pay, {MEDIAN.then.period}</p><p class="num mt-2 font-display text-[32px] font-semibold leading-none">{$(med.a0)}</p><p class="meta mt-1.5">a year ({$(MEDIAN.then.weekly)} a week), {$(med.net0)} after tax. Three months after the government took office.</p></div>
        <div class="bg-surface p-5"><p class="eyebrow">Median pay, {MEDIAN.now.period}</p><p class="num mt-2 font-display text-[32px] font-semibold leading-none">{$(med.a1)}</p><p class="meta mt-1.5">a year ({$(MEDIAN.now.weekly)} a week), {$(med.net1)} after tax. The latest ABS figure.</p></div>
        <div class:list={['p-5', med.diff >= 0 ? 'bg-good-tint' : 'bg-bad-tint']}><p class="eyebrow">After tax and inflation</p><p class:list={['num mt-2 font-display text-[32px] font-semibold leading-none', med.diff >= 0 ? 'text-good' : 'text-bad']}>{$(Math.abs(med.diff))} {med.diff >= 0 ? 'better off' : 'worse off'}</p><p class="meta mt-1.5">a year. The 2022 take-home pay is {$(med.real0)} in {MEDIAN.now.period.split(' ')[1]} prices (up {med.cpiPct.toFixed(1)}%).</p></div>
      </div>
    )}
    <p class="meta mt-2">Median weekly earnings in main job, all employees: ABS Employee Earnings (<a href={MEDIAN.then.url}>{MEDIAN.then.period}</a>, <a href={MEDIAN.now.url}>{MEDIAN.now.period}</a>). Taxed at {RULES_2223.label} and {RULES_2526.label} resident rates with the Medicare levy; prices from the CPI.</p>
    {NOW_RULES && Number.isFinite(CPI) && Number.isFinite(WPI) && <div class="mt-6"><HouseholdCalc client:visible then={RULES_2122} now={NOW_RULES} cpi={CPI} wpi={WPI} periodLabel={periodLabel} mortgage={mortgage} /></div>}
    <p class="lede mt-10">Across the {rec.total} measures where nearly everyone agrees which direction is better, <b class="text-ink">{rec.better.length} {rec.better.length === 1 ? 'is' : 'are'} better</b> than in mid-2022 and <b class="text-ink">{rec.worse.length} {rec.worse.length === 1 ? 'is' : 'are'} worse</b>{rec.steady.length ? `, with ${rec.steady.length} little changed` : ''}. Not all of it is the government’s doing: each measure says how much control Canberra has, and where the starting point was unusual.</p>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      {[{ h: 'Better than when it took office', list: rec.better, bg: 'bg-good-tint', tx: 'text-good' }, { h: 'Worse than when it took office', list: rec.worse, bg: 'bg-bad-tint', tx: 'text-bad' }].map((g) => (
        <div class="card overflow-hidden">
          <div class:list={['flex items-center justify-between gap-3 px-5 py-3', g.bg]}><h3 class:list={['h3', g.tx]}>{g.h}</h3><span class:list={['num font-display text-[26px] font-semibold', g.tx]}>{g.list.length}</span></div>
          <ul>{g.list.map((m) => (
            <li class="rule-t"><a href={url(`measures/${m.id}/`)} class="grid grid-cols-[1fr_auto] items-baseline gap-x-4 px-5 py-2.5 text-ink no-underline hover:bg-panel">
              <span class="font-semibold">{m.title}</span><span class:list={['num font-bold', g.tx]}>{m.sinceElection!.label}</span>
              <span class="meta col-span-2">{m.sinceElection!.periodLabel} · now {headlineText(m.headline)}</span></a></li>))}
            {g.list.length === 0 && <li class="rule-t px-5 py-4 text-ink-2">None on the latest figures.</li>}</ul>
        </div>))}
    </div>
    <p class="meta mt-4">Measures where “better” is a matter of political opinion (the size of government, migration, house prices, the cash rate) are left out of this count and shown below without a verdict. <a href={url('methodology/')}>How this is worked out</a></p>
  </section>

  <section id="commitments" class="wrap pt-16">
    <p class="eyebrow">Commitments</p>
    <h2 class="h2 mt-2">What the government said it would do</h2>
    <p class="lede mt-3">Each of these is a measurable commitment the government made itself: an election promise, a law it passed, or a target it signed. The verdict follows a published rule, applied to official figures.</p>
    <div class="mt-8 grid gap-4">
      {GOV_TARGETS.map((m, i) => <TargetRow m={m} i={i} />)}
    </div>
    <p class="mt-5 text-[16px]"><a href={url('targets/')} class="font-bold">Plus {DELIVERIES.length} commitments judged on delivery</a>, from the student debt cut to the urgent care clinics, {DELIVERIES.filter((d) => d.verdict === 'met').length} of which have been met.</p>
    {official.length > 0 && (
      <div class="mt-10">
        <h3 class="h3">An official target that isn’t the government’s to hit</h3>
        <p class="mt-1 max-w-[70ch] text-[15px] text-ink-2">The Reserve Bank is independent and sets interest rates to keep inflation in its target band. It’s shown here because it matters to every household, but it doesn’t count in the government’s tally.</p>
        <div class="mt-4 grid gap-4">{official.map((m, i) => <TargetRow m={m} i={i} />)}</div>
      </div>
    )}
  </section>

  <section class="wrap pt-20">
    <p class="eyebrow">Every measure</p>
    <h2 class="h2 mt-2">The figures, topic by topic</h2>
    <p class="lede mt-3">The latest official figure for each measure, how it has moved since the government took office, and how it moved over the past year. <a href={url('charts/')} class="font-bold">See every chart in full on one page</a>.</p>
    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13.5px] text-ink-2">
      <span class="inline-flex items-center gap-2"><span class="pill pill-good"><Icon name="up" size={13} />Better</span><span class="pill pill-bad"><Icon name="down" size={13} />Worse</span> used only where nearly everyone agrees which way is good</span>
      <span class="inline-flex items-center gap-2"><span class="pill pill-neutral"><Icon name="up" size={13} />Rising</span> used where that’s a matter of political opinion</span>
    </div>
    {groups.map((g) => (
      <div class="mt-12">
        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-rule-strong pb-2">
          <h3 class="font-display text-[23px] font-semibold">{g.title}</h3>
          <p class="meta">{g.blurb}</p>
        </div>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((m, i) => <MeasureCard m={m} i={i} />)}
        </div>
      </div>
    ))}
  </section>

  <section class="wrap pt-20">
    <div class="grid gap-4 md:grid-cols-3">
      {[
        { href: 'budget/build/', eyebrow: 'Interactive', h: 'Build your own Federal Budget', p: 'Start from the real Budget. Change any tax or spending line and watch the deficit, debt and interest bill respond.' },
        { href: 'learn/', eyebrow: 'Plain English', h: 'Learn how it works', p: 'Deficit or debt? Who sets interest rates? Short, interactive explainers with no jargon.' },
        { href: 'briefing/', eyebrow: '3D model', h: 'Every measure, mapped', p: 'Each topic is a sphere and each measure a moon, coloured by whether it is better or worse than when the government took office.' },
      ].map((c, i) => (
        <a href={url(c.href)} class="card card-link card-pad rise flex flex-col" style={`--i:${i}`}>
          <p class="eyebrow">{c.eyebrow}</p>
          <p class="mt-2 font-display text-[23px] font-semibold leading-tight">{c.h}</p>
          <p class="mt-2 text-[15px] text-ink-2">{c.p}</p>
          <p class="mt-5 inline-flex items-center gap-1.5 text-[14.5px] font-bold text-brand">Open <Icon name="arrow" size={15} /></p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap pt-20">
    <div class="card grid gap-6 bg-brand-tint p-7 md:grid-cols-[1fr_auto] md:items-center md:p-10" style="border-color:transparent">
      <div>
        <h2 class="h2">Know when the numbers change</h2>
        <p class="mt-2 max-w-[60ch] text-[16px] text-ink-2">A short email when a new figure lands or a verdict changes. No opinion, no spin, unsubscribe any time.</p>
      </div>
      <a class="btn btn-primary" href={url('subscribe/')}><Icon name="bell" />Get email updates</a>
    </div>
  </section>
</Base>
