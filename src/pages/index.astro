---
import Base from '../layouts/Base.astro';
import MeasureCard from '../components/MeasureCard.astro';
import ThenNowCard from '../components/ThenNowCard.astro';
import VerdictPill from '../components/VerdictPill.astro';
import Icon from '../components/Icon.astro';
import Orbit from '../components/Orbit.astro';
import ReportForm from '../components/ReportForm.astro';
import { SITE, url } from '../config/site';
import { MEASURES, GOV_TARGETS, DELIVERIES, CHECKS, GENERATED_AT, tally, record } from '../lib/measures';
import { headlineText } from '../lib/format';
import { VERDICT_TONE } from '../lib/editorial';
import { fmtStamp } from '../lib/format';
import { byId, BUDGET } from '../lib/measures';
import type { TaxRules } from '../lib/personalTax';
import { typicalHousehold } from '../lib/typicalHousehold';
import { latestFigures } from '../lib/latest';
import { fmtDate } from '../lib/format';
const latest = latestFigures(6, 45);

const t = tally();
const rec = record();
// Key figures: the same balanced set every time, chosen because they are the ones most often asked about, not for which way they point.
const KEY = ['inflation', 'unemployment', 'employment', 'real_wages', 'mortgage', 'gross_debt'].map(byId).filter(Boolean) as NonNullable<ReturnType<typeof byId>>[];
const segs = [
  { n: t.good, label: 'met or on track', color: 'var(--good)' },
  { n: t.progress, label: 'in progress', color: 'var(--ink-3)' },
  { n: t.risk, label: 'at risk', color: 'var(--warn)' },
  { n: t.bad, label: 'off track or not met', color: 'var(--bad)' },
].filter((s) => s.n > 0);
const txNow = (BUDGET?.years ?? []).map((y: any) => y.tax_rates).find(Boolean);
const NOW_RULES: TaxRules | null = txNow ? { label: txNow.income_year.replace(/[–—]/g, '-'), brackets: txNow.brackets, medicareRate: txNow.medicare_levy, medicareLow: txNow.medicare_low, lito: txNow.lito } : null;
const TH = typicalHousehold(NOW_RULES);
const $ = (v: number) => (v < 0 ? '−' : '') + '$' + Math.round(Math.abs(v)).toLocaleString('en-AU');
// Tracker preview: 8 commitments as an even mix. Sorted worst to best, then taken alternately from each end, so the
// first screen reflects the whole tally rather than the worst of it.
const allCommitments = [...GOV_TARGETS.map((m) => ({ href: url(`measures/${m.id}/`), title: m.title, verdict: m.verdict!.verdict })), ...DELIVERIES.map((d) => ({ href: url(`targets/#${d.id}`), title: d.title, verdict: d.verdict }))]
  .sort((a, b) => ['bad', 'warn', 'neutral', 'good'].indexOf(VERDICT_TONE[a.verdict]) - ['bad', 'warn', 'neutral', 'good'].indexOf(VERDICT_TONE[b.verdict]));
const preview: typeof allCommitments = [];
for (let i = 0, j = allCommitments.length - 1; preview.length < 8 && i <= j; i++, j--) { preview.push(allCommitments[i]); if (i !== j && preview.length < 8) preview.push(allCommitments[j]); }
// Delivery commitments (a law passed, a scheme open) and measured outcomes (a number reached) are counted separately as well as together.
const delivered = DELIVERIES.filter((d) => d.verdict === 'met').length;
const outcomesGood = GOV_TARGETS.filter((m) => m.verdict!.verdict === 'met' || m.verdict!.verdict === 'on_track').length;

const home = new URL(url(), Astro.site).href;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, alternateName: 'Gov Score Australia', description: SITE.description, url: home, inLanguage: 'en-AU' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: home, logo: new URL(url('favicon.svg'), Astro.site).href, description: 'An independent site that tracks the Australian Government against official figures.' },
];
---
<Base fullTitle="Gov Score: Albanese Government report card in official figures" description="Is Australia better off since May 2022? Promises kept and broken, cost of living, inflation, debt and more, from official figures checked daily. Free and independent." jsonld={jsonld}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-sky" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">{SITE.edition} · {SITE.government.name} · figures checked {fmtStamp(GENERATED_AT).replace(/,.*$/, '')}</p>
        <h1 id="hero-h" class="display hero-h">Holding the government to account,<br />in its own numbers.</h1>
        <p class="hero-lede">The government’s record on cost of living, housing, jobs, the Budget and more, in official figures. Every number links to its source. No editorial, no spin, no party line.</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a class="btn btn-light" href="#record">Explore the evidence <Icon name="arrow" /></a>
          <a class="hero-link" href={url('in-60-seconds/')}>Australia in 60 seconds <Icon name="arrow" size={15} /></a>
          <a class="hero-link" href={url('find/')}>Help me find it <Icon name="arrow" size={15} /></a>
        </div>
        <ul class="hero-tally" aria-label="Commitments at a glance">
          {segs.map((s) => <li><b class="num">{s.n}</b><span>{s.label}</span><i aria-hidden="true" style={`background:${s.color}`} /></li>)}
          <li><a href={url('targets/')}>All {t.total} commitments <Icon name="arrow" size={13} /></a></li>
        </ul>
      </div>
      <div class="hero-orbit"><Orbit /></div>
    </div>
  </section>

  {TH && (
  <section class="border-b border-rule" id="household">
    <div class="wrap grid gap-8 py-14 md:py-16 lg:grid-cols-[1.25fr_1fr] lg:items-center lg:gap-16">
      <div class="wallet">
        <p class="eyebrow">What it means for you</p>
        <fieldset class="wallet-toggle mt-4">
          <legend class="sr-only">Household type</legend>
          <input type="radio" name="wallet" id="w-own" class="sr-only" checked /><label for="w-own">Couple, mortgage</label>
          <input type="radio" name="wallet" id="w-rent" class="sr-only" /><label for="w-rent">Couple, renting</label>
          <input type="radio" name="wallet" id="w-single" class="sr-only" /><label for="w-single">Single, renting</label>
        </fieldset>
        {([['w-own-panel', TH.owner.diff, 'A couple on the median wage is', `2 median earners, the average new mortgage ($${Math.round(TH.loan / 1000)}k), a car and a weekly shop.`], ['w-rent-panel', TH.renter.diff, 'A couple on the median wage is', `2 median earners paying the median market rent (a new lease), a car and a weekly shop.`], ['w-single-panel', TH.single.diff, 'A single renter on the median wage is', `1 median earner paying the median market rent (a new lease), a car and half the household shop.`]] as const).map(([cls, d, lead, who]) => (
          <div class:list={['mt-6', cls]} aria-live="polite">
            <p class="font-display text-[clamp(26px,3.4vw,36px)] leading-tight">{lead}</p>
            <p class="mt-1 flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <span class="num font-display text-[clamp(76px,12vw,132px)] font-semibold leading-[0.9] tracking-tight text-brand">{$(Math.abs(d) / 52)}</span>
              <span class="font-display text-[clamp(22px,2.8vw,32px)] leading-tight">a week<br />{d >= 0 ? 'better off' : 'worse off'}</span>
            </p>
            <p class="lede mt-4">than in June 2022. That adds up to <b class="text-ink">{$(Math.abs(d))} a year</b>.</p>
            <p class="meta mt-3 max-w-[60ch]">{who} After tax and inflation, against June 2022. Official figures throughout; it measures what changed, not who caused it. The weekly figure is the yearly one divided by 52, each rounded separately.</p>
          </div>
        ))}
      </div>
      <div class="card card-pad shadow-card">
        <p class="eyebrow">How this is worked out</p>
        <p class="mt-2 text-[15.5px] text-ink-2">3 example households on the median wage, each with a car and a weekly shop. Pay after tax, compared with groceries, petrol, car costs and a new mortgage or a new lease, against June 2022 and adjusted for inflation. Every input is an official figure, and the full working is on the calculator page.</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a class="btn btn-primary" href={url('calculator/')}>Work out your own number <Icon name="arrow" /></a>
          <a class="inline-flex items-center gap-1.5 text-[14.5px] font-bold no-underline hover:underline" href={url('calculator/#typical')}>See the working <Icon name="arrow" size={15} /></a>
        </div>
        <div class="mt-6 border-t border-rule pt-5">
          <p class="text-[15px] font-semibold">Email me when this number changes</p>
          <div class="mt-3"><ReportForm kind="signup">
            <input type="hidden" name="topics" value="household" />
            <label class="sr-only" for="hh-email">Email address</label>
            <input id="hh-email" class="input" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
          </ReportForm></div>
          <p class="meta mt-2">1 short email when the household figure moves. No opinion, no spin, unsubscribe any time.</p>
        </div>
      </div>
    </div>
  </section>
  )}

  {latest.length > 0 && (
  <section class="border-b border-rule bg-panel">
    <div class="wrap py-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3"><p class="eyebrow">Latest figures</p><a href={url('latest/')} class="text-[14px] font-bold no-underline hover:underline">All, newest first <Icon name="arrow" size={14} /></a></div>
      <ul class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">{latest.map(({ m, date }) => (
        <li><a href={url(`measures/${m.id}/`)} class="flex items-baseline justify-between gap-3 text-[14.5px] text-ink no-underline hover:text-brand"><span><span class="font-semibold">{m.title}</span> <span class="num font-bold">{headlineText(m.headline)}</span></span><span class="meta mono whitespace-nowrap">{fmtDate(date)}</span></a></li>))}</ul>
    </div>
  </section>
  )}
  <section class="wrap pt-14 pb-16" id="figures">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="eyebrow">Key figures</p>
        <h2 class="h2 mt-2">Then and now: 6 key figures</h2>
        <p class="mt-2 text-[15.5px] text-ink-2">When the government took office, and the latest official figure.</p>
      </div>
      <a href={url('measures/')} class="inline-flex items-center gap-1.5 text-[15px] font-bold no-underline hover:underline">All {MEASURES.length} measures, topic by topic <Icon name="arrow" size={15} /></a>
    </div>
    <div class="tn-row mt-6">
      {KEY.map((m, i) => m.sinceElection ? <ThenNowCard m={m} i={i} /> : <MeasureCard m={m} i={i} />)}
    </div>
    <p class="mt-5 text-[15px]"><a href={url('charts/')} class="font-bold">See every chart on one page</a>, with 10 and 20 year views and G20 comparisons where they exist.</p>
  </section>

  <section class="border-y border-rule">
    <div class="wrap py-10 md:py-12">
      <div class="card card-pad shadow-card">
        <div class="flex items-baseline justify-between gap-3">
          <p class="eyebrow">Commitments tracker</p>
          <p class="meta mono">{fmtStamp(GENERATED_AT)}</p>
        </div>
        <p class="mt-3 font-display text-[22px] font-semibold leading-snug">{t.total} measurable commitments, judged on official figures.</p>
        <div class="mt-4 flex h-3 gap-[2px] overflow-hidden rounded-full" role="img" aria-label={segs.map((s) => `${s.n} ${s.label}`).join(', ')}>
          {segs.map((s) => <span style={`flex:${s.n};background:${s.color}`} />)}
        </div>
        <ul class="mt-4 grid gap-0 md:grid-cols-2 md:gap-x-10">
          {preview.map((x) => (
            <li class="rule-t">
              <a href={x.href} class="flex items-center justify-between gap-3 py-2 text-[14.5px] font-semibold text-ink no-underline hover:text-brand"><span>{x.title}</span><VerdictPill verdict={x.verdict} /></a>
            </li>
          ))}
        </ul>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
          <a href={url('targets/')} class="inline-flex items-center gap-1.5 text-[14.5px] font-bold no-underline hover:underline">See all {t.total} commitments <Icon name="arrow" size={15} /></a>
          <p class="meta"><b class="text-ink">{delivered} of {DELIVERIES.length}</b> things promised delivered (a law passed, a scheme opened); <b class="text-ink">{outcomesGood} of {GOV_TARGETS.length}</b> measured targets met or on track. Only commitments the government itself made are counted. <a href={url('methodology/')}>How verdicts work</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-rule bg-panel">
    <div class="wrap grid gap-x-8 gap-y-5 py-7 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { icon: 'ext', h: 'Every figure is sourced', p: 'Each number links to the official release it came from.' },
        { icon: 'shield', h: 'Tested every day', p: `${CHECKS.checks_total} automated checks on the latest data run: sources reached, figures in range, totals adding up.` },
        { icon: 'scale', h: 'Verdicts only on real promises', p: 'No pass or fail on things the government never committed to.' },
        { icon: 'quote', h: 'Mistakes are published', p: 'Corrections are logged in public, with dates.' },
      ].map((x) => (
        <div class="flex gap-3">
          <span class="mt-0.5 text-brand"><Icon name={x.icon} size={20} /></span>
          <p class="text-[14.5px] leading-snug"><span class="block font-bold">{x.h}</span><span class="text-ink-2">{x.p}</span></p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap pt-14">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div><p class="eyebrow">Who it’s for</p><h2 class="h2 mt-2">One set of figures, used 5 ways</h2></div>
      <a href={url('for/')} class="inline-flex items-center gap-1.5 text-[15px] font-bold no-underline hover:underline">What you get <Icon name="arrow" size={15} /></a>
    </div>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {[['newsrooms', 'Newsrooms', 'A quotable figure with the source, in 2 minutes.'], ['parties', 'Parties and MPs', 'Promise verdicts and share images, same rules for all.'], ['researchers', 'Researchers', 'Full series, method and downloads.'], ['classrooms', 'Classrooms', 'Charts, explainers and references that pass.'], ['households', 'Households', 'Are you better or worse off, in dollars a week.']].map(([id, h, p]) => (
        <li><a href={url(`for/#${id}`)} class="card card-link card-pad block h-full !text-ink"><p class="font-display text-[19px] font-semibold leading-tight">{h}</p><p class="mt-1.5 text-[14px] text-ink-2">{p}</p></a></li>))}
    </ul>
  </section>
  <section class="wrap pt-16" id="record">
    <p class="eyebrow">The record · since May 2022</p>
    <h2 class="h2 mt-2">What changed during the government’s term</h2>
    <p class="lede mt-3">Across the {rec.total} measures where nearly everyone agrees which direction is better, <b class="text-ink">{rec.better.length} {rec.better.length === 1 ? 'is' : 'are'} better</b> than in mid-2022 and <b class="text-ink">{rec.worse.length} {rec.worse.length === 1 ? 'is' : 'are'} worse</b>{rec.steady.length ? `, with ${rec.steady.length} little changed` : ''}. This is a count of what moved, not of what the government caused: each measure says how much control Canberra has, and where the starting point was unusual.</p>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      {[{ h: 'Better than when it took office', list: rec.better, bg: 'bg-good-tint', tx: 'text-good' }, { h: 'Worse than when it took office', list: rec.worse, bg: 'bg-bad-tint', tx: 'text-bad' }].map((g) => (
        <div class="card overflow-hidden">
          <div class:list={['flex items-center justify-between gap-3 px-5 py-3', g.bg]}><h3 class:list={['h3', g.tx]}>{g.h}</h3><span class:list={['num font-display text-[26px] font-semibold', g.tx]}>{g.list.length}</span></div>
          <ul>{g.list.slice(0, 4).map((m) => (
            <li class="rule-t"><a href={url(`measures/${m.id}/`)} class="grid grid-cols-[1fr_auto] items-baseline gap-x-4 px-5 py-2.5 text-ink no-underline hover:bg-panel">
              <span class="font-semibold">{m.title}</span><span class:list={['num font-bold', g.tx]}>{m.sinceElection!.label}</span>
              <span class="meta col-span-2">{m.sinceElection!.periodLabel} · now {headlineText(m.headline)}</span></a></li>))}
            {g.list.length === 0 && <li class="rule-t px-5 py-4 text-ink-2">None on the latest figures.</li>}</ul>
          {g.list.length > 4 && <details class="group"><summary class="flex cursor-pointer list-none items-center gap-2 border-t border-rule px-5 py-2.5 text-[14px] font-bold text-brand [&::-webkit-details-marker]:hidden"><span aria-hidden="true" class="inline-block transition-transform group-open:rotate-90">▸</span> All {g.list.length}</summary>
            <ul>{g.list.slice(4).map((m) => (
              <li class="rule-t"><a href={url(`measures/${m.id}/`)} class="grid grid-cols-[1fr_auto] items-baseline gap-x-4 px-5 py-2.5 text-ink no-underline hover:bg-panel">
                <span class="font-semibold">{m.title}</span><span class:list={['num font-bold', g.tx]}>{m.sinceElection!.label}</span>
                <span class="meta col-span-2">{m.sinceElection!.periodLabel} · now {headlineText(m.headline)}</span></a></li>))}</ul></details>}
        </div>))}
    </div>
    {rec.steady.length > 0 && (
      <div class="card mt-5 overflow-hidden">
        <div class="flex items-center justify-between gap-3 bg-panel px-5 py-3"><h3 class="h3">Little changed</h3><span class="num font-display text-[26px] font-semibold">{rec.steady.length}</span></div>
        <ul class="grid md:grid-cols-2">{rec.steady.map((m) => (
          <li class="rule-t"><a href={url(`measures/${m.id}/`)} class="grid grid-cols-[1fr_auto] items-baseline gap-x-4 px-5 py-2.5 text-ink no-underline hover:bg-panel">
            <span class="font-semibold">{m.title}</span><span class="num font-bold text-ink-2">{m.sinceElection!.label}</span>
            <span class="meta col-span-2">{m.sinceElection!.periodLabel} · now {headlineText(m.headline)}</span></a></li>))}</ul>
      </div>
    )}
    <p class="meta mt-4">Measures where “better” is a matter of political opinion (the size of government, migration, house prices, the cash rate) are left out of this count and shown without a verdict. <a href={url('methodology/')}>How this is worked out</a></p>
  </section>

  <section class="wrap pt-20">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { href: 'budget/build/', eyebrow: 'Interactive', h: 'Build your own Federal Budget', p: 'Start from the real Budget. Change any tax or spending line and watch the deficit, debt and interest bill respond.' },
        { href: 'briefing/', eyebrow: '3D model', h: 'Every measure, mapped', p: 'Every measure in one interactive 3D model, showing how they all fit together in the bigger picture.' },
        { href: 'classrooms/', eyebrow: 'Learn and teach', h: 'Explainers and classroom tools', p: 'Deficit or debt? Who sets interest rates? Short explainers with no jargon, plus a page for teachers and students.' },
        { href: 'make-your-own-chart/', eyebrow: 'Free to reuse', h: 'Make your own chart', p: 'Download any series as a spreadsheet, redraw it your way for a newsletter, report or classroom, and credit the source in 1 line.' },
      ].map((c, i) => (
        <a href={url(c.href)} class="card card-link card-pad rise flex flex-col" style={`--i:${i}`}>
          <p class="eyebrow">{c.eyebrow}</p>
          <p class="mt-2 font-display text-[23px] font-semibold leading-tight">{c.h}</p>
          <p class="mt-2 text-[15px] text-ink-2">{c.p}</p>
          <p class="mt-5 inline-flex items-center gap-1.5 text-[14.5px] font-bold text-brand">Open <Icon name="arrow" size={15} /></p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap pt-20">
    <div class="card grid gap-6 bg-brand-tint p-7 md:grid-cols-[1fr_auto] md:items-center md:p-10" style="border-color:transparent">
      <div>
        <h2 class="h2">Know when the numbers change</h2>
        <p class="mt-2 max-w-[60ch] text-[16px] text-ink-2">A short email when a new figure lands or a verdict changes. No opinion, no spin, unsubscribe any time.</p>
      </div>
      <a class="btn btn-primary" href={url('subscribe/')}><Icon name="bell" />Get email updates</a>
    </div>
  </section>
</Base>

<style>
  /* Hero: always on night, whatever the theme, so the mark and the orbit have the dark they need. */
  .hero { position: relative; overflow: hidden; background: var(--night); color: var(--on-night); isolation: isolate; }
  .hero-sky { position: absolute; inset: 0; z-index: -1; background:
      radial-gradient(60% 50% at 78% 45%, rgb(50 90 230 / 0.22) 0%, transparent 70%),
      radial-gradient(40% 36% at 70% 70%, color-mix(in srgb, var(--aurora-1) 12%, transparent) 0%, transparent 70%),
      radial-gradient(30% 30% at 88% 20%, color-mix(in srgb, var(--aurora-3) 10%, transparent) 0%, transparent 70%),
      linear-gradient(180deg, var(--night) 0%, var(--night-2) 100%); }
  .hero-sky::after { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgb(255 255 255 / 0.07) 0.6px, transparent 0.7px); background-size: 22px 22px; mask-image: radial-gradient(70% 70% at 70% 50%, #000 20%, transparent 100%); }
  .hero-grid { display: grid; gap: 20px; padding-block: 16px 36px; }
  .hero-orbit { order: -1; }
  .hero-copy { max-width: 560px; }
  .hero-kicker { font-size: 13px; font-weight: 600; color: var(--on-night-2); }
  .hero-h { margin-top: 14px; font-size: clamp(40px, 5vw, 66px); color: var(--on-night); max-width: 11ch; }
  .hero-lede { margin-top: 20px; max-width: 54ch; font-size: clamp(17px, 1.7vw, 19px); line-height: 1.55; color: var(--on-night-2); }
  .btn-light { background: var(--on-night); color: var(--night); }
  @media (hover: hover) and (pointer: fine) { .btn-light:hover { background: #fff; } }
  .hero-link { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--on-night); text-decoration: none; }
  .hero-link:hover { text-decoration: underline; }
  .hero-tally { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--night-rule); font-size: 14px; color: var(--on-night-2); }
  .hero-tally li { display: inline-flex; align-items: center; gap: 7px; }
  .hero-tally b { font-size: 18px; color: var(--on-night); }
  .hero-tally i { width: 8px; height: 8px; border-radius: 50%; }
  .hero-tally a { color: var(--on-night); font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
  .hero-tally a:hover { text-decoration: underline; }
  .hero-orbit { width: 100%; }
  @media (min-width: 1024px) {
    .hero-orbit { order: 0; }
    .hero-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: 48px; padding-block: 64px 48px; min-height: calc(100vh - var(--header-h)); max-height: 880px; }
    .hero-orbit { justify-self: end; width: min(100%, 720px); }
    .hero-grid { overflow: visible; }
  }

  /* Household type switch: plain radio buttons, so it works without JavaScript. */
  .wallet-toggle { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border: 0; margin: 0; max-width: 100%; border-radius: 24px; background: var(--panel); }
