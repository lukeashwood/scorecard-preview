---
import Base from '../layouts/Base.astro';
import MeasureCard from '../components/MeasureCard.astro';
import VerdictPill from '../components/VerdictPill.astro';
import Icon from '../components/Icon.astro';
import { SITE, url } from '../config/site';
import { MEASURES, GOV_TARGETS, DELIVERIES, CHECKS, GENERATED_AT, tally, record } from '../lib/measures';
import { headlineText } from '../lib/format';
import { VERDICT_TONE } from '../lib/editorial';
import { fmtStamp } from '../lib/format';
import { byId, BUDGET } from '../lib/measures';
import type { TaxRules } from '../lib/personalTax';
import { typicalHousehold } from '../lib/typicalHousehold';

const t = tally();
const rec = record();
// Key figures: the same balanced set every time, chosen because they are the ones most often asked about, not for which way they point.
const KEY = ['inflation', 'unemployment', 'employment', 'real_wages', 'mortgage', 'gross_debt'].map(byId).filter(Boolean) as NonNullable<ReturnType<typeof byId>>[];
const segs = [
  { n: t.good, label: 'met or on track', color: 'var(--good)' },
  { n: t.progress, label: 'in progress', color: 'var(--ink-3)' },
  { n: t.risk, label: 'at risk', color: 'var(--warn)' },
  { n: t.bad, label: 'off track or not met', color: 'var(--bad)' },
].filter((s) => s.n > 0);
const txNow = (BUDGET?.years ?? []).map((y: any) => y.tax_rates).find(Boolean);
const NOW_RULES: TaxRules | null = txNow ? { label: txNow.income_year.replace(/[–—]/g, '-'), brackets: txNow.brackets, medicareRate: txNow.medicare_levy, medicareLow: txNow.medicare_low, lito: txNow.lito } : null;
const TH = typicalHousehold(NOW_RULES);
const $ = (v: number) => (v < 0 ? '−' : '') + '$' + Math.round(Math.abs(v)).toLocaleString('en-AU');

const home = new URL(url(), Astro.site).href;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, alternateName: 'Gov Score Australia', description: SITE.description, url: home, inLanguage: 'en-AU' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: home, logo: new URL(url('favicon.svg'), Astro.site).href, description: 'An independent site that tracks the Australian Government against official figures.' },
];
---
<Base fullTitle="Gov Score: Albanese Government report card in official figures" description="Is Australia better off since May 2022? Promises kept and broken, cost of living, inflation, debt and more, from official figures checked daily. Free and independent." jsonld={jsonld}>
  <section class="border-b border-rule">
    <div class="wrap grid gap-10 py-12 md:py-16 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16">
      <div>
        <p class="eyebrow">{SITE.edition} · {SITE.government.name}</p>
        <h1 class="display mt-3 text-[clamp(38px,5.6vw,64px)]">We provide the facts. <span class="text-brand">You decide the score.</span></h1>
        <p class="lede mt-5">Australia’s premier source of non-partisan data on federal government performance. The current government’s record on cost of living, housing, jobs, the Budget and more, set against decades of history and, where possible, the rest of the G20. All in one place. Every number links to its official source. No editorial, no spin, no party line.</p>
        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a class="btn btn-primary" href="#record">Explore the evidence <Icon name="arrow" /></a>
          <a class="inline-flex items-center gap-1.5 font-bold no-underline hover:underline" href={url('in-60-seconds/')}>Australia in 60 seconds <Icon name="arrow" size={15} /></a>
        </div>
      </div>

      <div class="card card-pad shadow-card">
        <div class="flex items-baseline justify-between gap-3">
          <p class="eyebrow">Commitments tracker</p>
          <p class="meta mono">{fmtStamp(GENERATED_AT)}</p>
        </div>
        <p class="mt-3 font-display text-[22px] font-semibold leading-snug">{t.total} measurable commitments, judged on official figures.</p>
        <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[14px] text-ink-2">
          {segs.map((s) => <li class="inline-flex items-center gap-1.5"><span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-full" style={`background:${s.color}`} /><b class="num text-ink">{s.n}</b> {s.label}</li>)}
        </ul>
        <div class="mt-4 flex h-3 gap-[2px] overflow-hidden rounded-full" role="img" aria-label={segs.map((s) => `${s.n} ${s.label}`).join(', ')}>
          {segs.map((s) => <span style={`flex:${s.n};background:${s.color}`} />)}
        </div>
        <ul class="mt-4 grid gap-0">
          {[...GOV_TARGETS.map((m) => ({ href: url(`measures/${m.id}/`), title: m.title, verdict: m.verdict!.verdict })), ...DELIVERIES.map((d) => ({ href: url(`targets/#${d.id}`), title: d.title, verdict: d.verdict }))]
            .sort((a, b) => ['bad', 'warn', 'neutral', 'good'].indexOf(VERDICT_TONE[a.verdict]) - ['bad', 'warn', 'neutral', 'good'].indexOf(VERDICT_TONE[b.verdict])).slice(0, 7).map((x) => (
            <li class="rule-t first:border-t-0">
              <a href={x.href} class="flex items-center justify-between gap-3 py-2 text-[14.5px] font-semibold text-ink no-underline hover:text-brand"><span>{x.title}</span><VerdictPill verdict={x.verdict} /></a>
            </li>
          ))}
        </ul>
        <a href={url('targets/')} class="mt-2 inline-flex items-center gap-1.5 text-[14.5px] font-bold no-underline hover:underline">See all {t.total} commitments <Icon name="arrow" size={15} /></a>
        <p class="meta mt-3">Only commitments the government itself made are counted. <a href={url('methodology/')}>How verdicts work</a></p>
      </div>
    </div>
  </section>

  <section class="border-b border-rule bg-panel">
    <div class="wrap grid gap-x-8 gap-y-5 py-7 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { icon: 'ext', h: 'Every figure is sourced', p: 'Each number links to the official release it came from.' },
        { icon: 'shield', h: 'Tested every day', p: `${CHECKS.checks_total} automated checks on the latest data run: sources reached, figures in range, totals adding up.` },
        { icon: 'scale', h: 'Verdicts only on real promises', p: 'No pass or fail on things the government never committed to.' },
        { icon: 'quote', h: 'Mistakes are published', p: 'Corrections are logged in public, with dates.' },
      ].map((x) => (
        <div class="flex gap-3">
          <span class="mt-0.5 text-brand"><Icon name={x.icon} size={20} /></span>
          <p class="text-[14.5px] leading-snug"><span class="block font-bold">{x.h}</span><span class="text-ink-2">{x.p}</span></p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap pt-16" id="record">
    <p class="eyebrow">The record · since May 2022</p>
    <h2 class="h2 mt-2">What has changed since the government took office</h2>
    <p class="lede mt-3">Across the {rec.total} measures where nearly everyone agrees which direction is better, <b class="text-ink">{rec.better.length} {rec.better.length === 1 ? 'is' : 'are'} better</b> than in mid-2022 and <b class="text-ink">{rec.worse.length} {rec.worse.length === 1 ? 'is' : 'are'} worse</b>{rec.steady.length ? `, with ${rec.steady.length} little changed` : ''}. Not all of it is the government’s doing: each measure says how much control Canberra has, and where the starting point was unusual.</p>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      {[{ h: 'Better than when it took office', list: rec.better, bg: 'bg-good-tint', tx: 'text-good' }, { h: 'Worse than when it took office', list: rec.worse, bg: 'bg-bad-tint', tx: 'text-bad' }].map((g) => (
        <div class="card overflow-hidden">
          <div class:list={['flex items-center justify-between gap-3 px-5 py-3', g.bg]}><h3 class:list={['h3', g.tx]}>{g.h}</h3><span class:list={['num font-display text-[26px] font-semibold', g.tx]}>{g.list.length}</span></div>
          <ul>{g.list.map((m) => (
            <li class="rule-t"><a href={url(`measures/${m.id}/`)} class="grid grid-cols-[1fr_auto] items-baseline gap-x-4 px-5 py-2.5 text-ink no-underline hover:bg-panel">
              <span class="font-semibold">{m.title}</span><span class:list={['num font-bold', g.tx]}>{m.sinceElection!.label}</span>
              <span class="meta col-span-2">{m.sinceElection!.periodLabel} · now {headlineText(m.headline)}</span></a></li>))}
            {g.list.length === 0 && <li class="rule-t px-5 py-4 text-ink-2">None on the latest figures.</li>}</ul>
        </div>))}
    </div>
    {rec.steady.length > 0 && (
      <div class="card mt-5 overflow-hidden">
        <div class="flex items-center justify-between gap-3 bg-panel px-5 py-3"><h3 class="h3">Little changed</h3><span class="num font-display text-[26px] font-semibold">{rec.steady.length}</span></div>
        <ul class="grid md:grid-cols-2">{rec.steady.map((m) => (
          <li class="rule-t"><a href={url(`measures/${m.id}/`)} class="grid grid-cols-[1fr_auto] items-baseline gap-x-4 px-5 py-2.5 text-ink no-underline hover:bg-panel">
            <span class="font-semibold">{m.title}</span><span class="num font-bold text-ink-2">{m.sinceElection!.label}</span>
            <span class="meta col-span-2">{m.sinceElection!.periodLabel} · now {headlineText(m.headline)}</span></a></li>))}</ul>
      </div>
    )}
    <p class="meta mt-4">Measures where “better” is a matter of political opinion (the size of government, migration, house prices, the cash rate) are left out of this count and shown without a verdict. <a href={url('methodology/')}>How this is worked out</a></p>
  </section>

  <section class="wrap pt-20" id="figures">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="eyebrow">Key figures</p>
        <h2 class="h2 mt-2">6 key figures</h2>
      </div>
      <a href={url('measures/')} class="inline-flex items-center gap-1.5 text-[15px] font-bold no-underline hover:underline">All {MEASURES.length} measures, topic by topic <Icon name="arrow" size={15} /></a>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {KEY.map((m, i) => <MeasureCard m={m} i={i} />)}
    </div>
    <p class="mt-5 text-[15px]"><a href={url('charts/')} class="font-bold">See every chart on one page</a>, with 10 and 20 year views and G20 comparisons where they exist.</p>
  </section>

  {TH && (
  <section class="wrap pt-20" id="household">
    <p class="eyebrow">Households</p>
    <h2 class="h2 mt-2">What it means for a household</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <a href={url('calculator/#typical')} class="card card-link card-pad flex flex-col">
        <p class="eyebrow">Worked example: a typical household</p>
        <p class="mt-2 text-[15px] text-ink-2">A couple on the median wage, with a car and a weekly shop, after tax, prices and housing costs, against June 2022.</p>
        <dl class="mt-4 grid grid-cols-2 gap-4">
          {([['With a mortgage', TH.owner.diff], ['Renting', TH.renter.diff]] as const).map(([l, d]) => (
            <div><dt class="meta">{l}</dt><dd class:list={['num font-display text-[28px] font-semibold leading-tight', d >= 0 ? 'text-good' : 'text-bad']}>{$(Math.abs(d))}</dd><dd class="meta">a year {d >= 0 ? 'better off' : 'worse off'}</dd></div>
          ))}
        </dl>
        <p class="mt-auto pt-5 inline-flex items-center gap-1.5 text-[14.5px] font-bold text-brand">See the working <Icon name="arrow" size={15} /></p>
      </a>
      <a href={url('calculator/')} class="card card-link card-pad flex flex-col">
        <p class="eyebrow">Your own pay</p>
        <p class="mt-2 font-display text-[24px] font-semibold leading-tight">Are you better or worse off than in 2022?</p>
        <p class="mt-2 text-[15px] text-ink-2">Enter what you earn. The calculator compares your take-home pay today with the same job in 2022-23, after tax and inflation, and can add your mortgage or rent.</p>
        <p class="mt-auto pt-5 inline-flex items-center gap-1.5 text-[14.5px] font-bold text-brand">Try the calculator <Icon name="arrow" size={15} /></p>
      </a>
    </div>
  </section>
  )}

  <section class="wrap pt-20">
    <div class="grid gap-4 md:grid-cols-3">
      {[
        { href: 'budget/build/', eyebrow: 'Interactive', h: 'Build your own Federal Budget', p: 'Start from the real Budget. Change any tax or spending line and watch the deficit, debt and interest bill respond.' },
        { href: 'learn/', eyebrow: 'Plain English', h: 'Learn how it works', p: 'Deficit or debt? Who sets interest rates? Short, interactive explainers with no jargon.' },
        { href: 'briefing/', eyebrow: '3D model', h: 'Every measure, mapped', p: 'Every measure in one interactive 3D model, showing how they all fit together in the bigger picture.' },
      ].map((c, i) => (
        <a href={url(c.href)} class="card card-link card-pad rise flex flex-col" style={`--i:${i}`}>
          <p class="eyebrow">{c.eyebrow}</p>
          <p class="mt-2 font-display text-[23px] font-semibold leading-tight">{c.h}</p>
          <p class="mt-2 text-[15px] text-ink-2">{c.p}</p>
          <p class="mt-5 inline-flex items-center gap-1.5 text-[14.5px] font-bold text-brand">Open <Icon name="arrow" size={15} /></p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap pt-20">
    <div class="card grid gap-6 bg-brand-tint p-7 md:grid-cols-[1fr_auto] md:items-center md:p-10" style="border-color:transparent">
      <div>
        <h2 class="h2">Know when the numbers change</h2>
        <p class="mt-2 max-w-[60ch] text-[16px] text-ink-2">A short email when a new figure lands or a verdict changes. No opinion, no spin, unsubscribe any time.</p>
      </div>
      <a class="btn btn-primary" href={url('subscribe/')}><Icon name="bell" />Get email updates</a>
    </div>
  </section>
</Base>
