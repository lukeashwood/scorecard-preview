---
import Base from '../layouts/Base.astro';
import MeasureCard from '../components/MeasureCard.astro';
import ThenNowCard from '../components/ThenNowCard.astro';
import VerdictPill from '../components/VerdictPill.astro';
import Icon from '../components/Icon.astro';
import Orbit from '../components/Orbit.astro';
import ReportForm from '../components/ReportForm.astro';
import { SITE, url } from '../config/site';
import { MEASURES, GOV_TARGETS, DELIVERIES, CHECKS, GENERATED_AT, tally, record } from '../lib/measures';
import { headlineText } from '../lib/format';
import { VERDICT_TONE } from '../lib/editorial';
import { fmtStamp } from '../lib/format';
import { byId, BUDGET } from '../lib/measures';
import type { TaxRules } from '../lib/personalTax';
import { typicalHousehold } from '../lib/typicalHousehold';
import { latestFigures } from '../lib/latest';
import { fmtDate } from '../lib/format';
const latest = latestFigures(6, 45);

const t = tally();
const recOffice = record('office');
const recTerm = record('term');
// Key figures: the numbers families feel and the ones that will be left for the next government to pay.
const KEY = ['inflation', 'unemployment', 'real_wages', 'mortgage', 'gross_debt', 'net_worth'].map(byId).filter(Boolean) as NonNullable<ReturnType<typeof byId>>[];
const segs = [
  { n: t.bad, label: 'broken or off track', color: 'var(--red)' },
  { n: t.risk, label: 'at risk', color: 'var(--warn)' },
  { n: t.progress, label: 'still not delivered', color: 'var(--on-night-2)' },
].filter((s) => s.n > 0);
const txNow = (BUDGET?.years ?? []).map((y: any) => y.tax_rates).find(Boolean);
const NOW_RULES: TaxRules | null = txNow ? { label: txNow.income_year.replace(/[–—]/g, '-'), brackets: txNow.brackets, medicareRate: txNow.medicare_levy, medicareLow: txNow.medicare_low, lito: txNow.lito } : null;
const TH0 = typicalHousehold(NOW_RULES);
// Only the households that have gone backwards are shown.
const HH = TH0 ? ([['w-own', 'Couple, mortgage', TH0.owner.diff, 'A couple on the median wage is', `2 median earners, the average new mortgage ($${Math.round(TH0.loan / 1000)}k), a car and a weekly shop.`], ['w-rent', 'Couple, renting', TH0.renter.diff, 'A couple on the median wage is', `2 median earners paying the median market rent (a new lease), a car and a weekly shop.`], ['w-single', 'Single, renting', TH0.single.diff, 'A single renter on the median wage is', `1 median earner paying the median market rent (a new lease), a car and half the household shop.`]] as const).filter((h) => h[2] < 0) : [];
const TH = HH.length ? TH0 : null;
const $ = (v: number) => (v < 0 ? '−' : '') + '$' + Math.round(Math.abs(v)).toLocaleString('en-AU');
// Tracker preview: the worst first.
const allCommitments = [...GOV_TARGETS.map((m) => ({ href: url(`measures/${m.id}/`), title: m.title, verdict: m.verdict!.verdict })), ...DELIVERIES.map((d) => ({ href: url(`targets/#${d.id}`), title: d.title, verdict: d.verdict }))]
  .sort((a, b) => ['bad', 'warn', 'neutral', 'good'].indexOf(VERDICT_TONE[a.verdict]) - ['bad', 'warn', 'neutral', 'good'].indexOf(VERDICT_TONE[b.verdict]));
const preview = allCommitments.slice(0, 8);

const home = new URL(url(), Astro.site).href;
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, alternateName: 'Gov Score Australia', description: SITE.description, url: home, inLanguage: 'en-AU', publisher: { '@type': 'Organization', name: SITE.name, url: home }, potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${new URL(url('find/'), Astro.site).href}?q={search_term_string}` }, 'query-input': 'required name=search_term_string' } },
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: home, logo: { '@type': 'ImageObject', url: new URL(url('icon-512.png'), Astro.site).href, width: 512, height: 512 }, description: 'The Albanese Government’s economic record in official figures.' },
];
---
<Base fullTitle="Gov Score: the Albanese Government’s record, in official figures" description="Broken promises, record debt and a cost of living that keeps climbing. The Albanese Government’s record in its own official figures, every one sourced." jsonld={jsonld}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-sky" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">{SITE.edition} · {SITE.government.name} · figures checked {fmtStamp(GENERATED_AT).replace(/,.*$/, '')}</p>
        <h1 id="hero-h" class="display hero-h">Labor’s record, <span class="text-[var(--red)] hero-red">in its own numbers.</span></h1>
        <p class="hero-lede">Higher prices, dearer mortgages, record debt and promises that never arrived. This is what Australian families have been living with, taken straight from the ABS, the Reserve Bank and the Budget papers. Every number links to its source, so you can check it and quote it.</p>
        <div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href="#record">See the record <Icon name="arrow" /></a><a class="btn btn-light" href={url('backflips/')}>The backflips</a></div>
        <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
          <a class="hero-link" href={url('in-60-seconds/')}>Australia in 60 seconds <Icon name="arrow" size={15} /></a>
          <a class="hero-link" href={url('find/')}>Help me find it <Icon name="arrow" size={15} /></a>
        </div>
      </div>
      <div class="hero-orbit"><Orbit /></div>
      <ul class="hero-tally" aria-label="Commitments at a glance">
        {segs.map((s) => <li><b class="num">{s.n}</b><span>{s.label}</span><i aria-hidden="true" style={`background:${s.color}`} /></li>)}
        <li><a href={url('targets/')}>The broken promises <Icon name="arrow" size={13} /></a></li>
      </ul>
    </div>
  </section>

  {TH && (
  <section class="border-b border-rule" id="household">
    <div class="wrap grid gap-8 py-14 md:py-16 lg:grid-cols-[1.25fr_1fr] lg:items-center lg:gap-16">
      <div class="wallet">
        <p class="eyebrow">What it means for you</p>
        <fieldset class="wallet-toggle mt-4">
          <legend class="sr-only">Household type</legend>
          {HH.map(([id, label], k) => <><input type="radio" name="wallet" id={id} class="sr-only" checked={k === 0} /><label for={id}>{label}</label></>)}
        </fieldset>
        {HH.map(([id, , d, lead, who]) => (
          <div class:list={['mt-6 w-panel', `${id}-panel`]} aria-live="polite">
            <p class="font-display text-[clamp(26px,3.4vw,36px)] leading-tight">{lead}</p>
            <p class="mt-1 flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <span class="num font-display text-[clamp(76px,12vw,132px)] font-extrabold leading-[0.9] tracking-tight text-[var(--red)]">{$(Math.abs(d) / 52)}</span>
              <span class="font-display text-[clamp(22px,2.8vw,32px)] leading-tight">a week<br />worse off</span>
            </p>
            <p class="lede mt-4">than in June 2022. That’s <b class="text-ink">{$(Math.abs(d))} a year</b> gone from the family budget.</p>
            <p class="meta mt-3 max-w-[60ch]">{who} After tax and inflation, against June 2022, using official figures throughout. The weekly figure is the yearly one divided by 52, each rounded separately.</p>
          </div>
        ))}
      </div>
      <div class="card card-pad shadow-card">
        <p class="eyebrow">How this is worked out</p>
        <p class="mt-2 text-[15.5px] text-ink-2">3 example households on the median wage, each with a car and a weekly shop. Pay after tax, compared with groceries, petrol, car costs and a new mortgage or a new lease, against June 2022 and adjusted for inflation. Every input is an official figure, and the full working is on the calculator page.</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a class="btn btn-primary" href={url('calculator/')}>Work out your own number <Icon name="arrow" /></a>
          <a class="inline-flex items-center gap-1.5 text-[14.5px] font-bold no-underline hover:underline" href={url('calculator/#typical')}>See the working <Icon name="arrow" size={15} /></a>
        </div>
        <div class="mt-6 border-t border-rule pt-5">
          <p class="text-[15px] font-semibold">Email me when this number changes</p>
          <div class="mt-3"><ReportForm kind="signup">
            <input type="hidden" name="topics" value="household" />
            <label class="sr-only" for="hh-email">Email address</label>
            <input id="hh-email" class="input" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
          </ReportForm></div>
          <p class="meta mt-2">1 short email when the household figure moves. Unsubscribe any time.</p>
        </div>
      </div>
    </div>
  </section>
  )}

  {latest.length > 0 && (
  <section class="border-b border-rule bg-panel">
    <div class="wrap py-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3"><p class="eyebrow">Latest figures</p><a href={url('latest/')} class="text-[14px] font-bold no-underline hover:underline">All, newest first <Icon name="arrow" size={14} /></a></div>
      <ul class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">{latest.map(({ m, date }) => (
        <li><a href={url(`measures/${m.id}/`)} class="flex items-baseline justify-between gap-3 text-[14.5px] text-ink no-underline hover:text-brand"><span><span class="font-semibold">{m.title}</span> <span class="num font-bold">{headlineText(m.headline)}</span></span><span class="meta mono whitespace-nowrap">{fmtDate(date)}</span></a></li>))}</ul>
    </div>
  </section>
  )}
  <section class="wrap pt-14 pb-16" id="figures">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="eyebrow">Key figures</p>
        <h2 class="h2 mt-2">Then and now: 6 key figures</h2>
        <p class="mt-2 text-[15.5px] text-ink-2"><span class="p-term">At the May 2025 election, and the latest official figure.</span><span class="p-office">When the government took office in May 2022, and the latest official figure.</span> Use the switch at the top to change the starting point.</p>
      </div>
      <a href={url('measures/')} class="inline-flex items-center gap-1.5 text-[15px] font-bold no-underline hover:underline">All {MEASURES.length} measures, topic by topic <Icon name="arrow" size={15} /></a>
    </div>
    <div class="tn-row mt-6">
      {KEY.map((m, i) => <>{m.thisTerm ? <ThenNowCard m={m} i={i} period="term" /> : <div class="p-term"><MeasureCard m={m} i={i} /></div>}{m.sinceElection ? <ThenNowCard m={m} i={i} period="office" /> : <div class="p-office"><MeasureCard m={m} i={i} /></div>}</>)}
    </div>
    <p class="mt-5 text-[15px]"><a href={url('charts/')} class="font-bold">See every chart on one page</a>, with 10 and 20 year views and G20 comparisons where they exist.</p>
  </section>

  <section class="border-y border-rule">
    <div class="wrap py-10 md:py-12">
      <div class="card card-pad shadow-card">
        <div class="flex items-baseline justify-between gap-3">
          <p class="eyebrow">Broken promises</p>
          <p class="meta mono">{fmtStamp(GENERATED_AT)}</p>
        </div>
        <p class="mt-3 font-display text-[22px] font-bold leading-snug">They said it, they put a number on it, and the official figures show they haven’t delivered.</p>
        <div class="mt-4 flex h-3 gap-[2px] overflow-hidden rounded-full" role="img" aria-label={segs.map((s) => `${s.n} ${s.label}`).join(', ')}>
          {segs.map((s) => <span style={`flex:${s.n};background:${s.color}`} />)}
        </div>
        <ul class="mt-4 grid gap-0 md:grid-cols-2 md:gap-x-10">
          {preview.map((x) => (
            <li class="rule-t">
              <a href={x.href} class="flex items-center justify-between gap-3 py-2 text-[14.5px] font-semibold text-ink no-underline hover:text-brand"><span>{x.title}</span><VerdictPill verdict={x.verdict} /></a>
            </li>
          ))}
        </ul>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
          <a href={url('targets/')} class="inline-flex items-center gap-1.5 text-[14.5px] font-bold no-underline hover:underline">Every broken promise, with the source <Icon name="arrow" size={15} /></a>
          <p class="meta">Each one is a commitment the government made itself, judged against its own deadline. <a href={url('methodology/')}>How verdicts work</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-rule bg-panel">
    <div class="wrap grid gap-x-8 gap-y-5 py-7 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { icon: 'ext', h: 'Every figure is sourced', p: 'Each number links to the official release it came from.' },
        { icon: 'shield', h: 'Tested every day', p: `${CHECKS.checks_total} automated checks on the latest data run: sources reached, figures in range, totals adding up.` },
        { icon: 'scale', h: 'Their promises, their deadlines', p: 'Promises are judged against the government’s own words and dates.' },
        { icon: 'quote', h: 'Ready to quote', p: 'Copy any figure with its source in 1 click, for a speech, a post or a doorknock.' },
      ].map((x) => (
        <div class="flex gap-3">
          <span class="mt-0.5 text-brand"><Icon name={x.icon} size={20} /></span>
          <p class="text-[14.5px] leading-snug"><span class="block font-bold">{x.h}</span><span class="text-ink-2">{x.p}</span></p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap pt-16" id="record">
    {([['p-term', recTerm, 'The record · this term', 'Worse than at the May 2025 election', 'since the government was re-elected in May 2025', 'at the May 2025 election'], ['p-office', recOffice, 'The record · since May 2022', 'Worse than when Labor took office', 'since Labor took office in May 2022', 'when Labor took office in May 2022']] as const).map(([cls, rec, eyebrow, h, since, when]) => (
    <div class={cls}>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="h2 mt-2">What’s gone backwards {since}</h2>
      <p class="lede mt-3"><b class="text-ink">{rec.worse.length} measures</b> are worse now than {when}, on the government’s own official figures.</p>
      <div class="card mt-7 overflow-hidden">
        <div class="flex items-center justify-between gap-3 bg-bad-tint px-5 py-3"><h3 class="h3 text-bad">{h}</h3><span class="num font-display text-[26px] font-extrabold text-bad">{rec.worse.length}</span></div>
        <ul class="grid md:grid-cols-2">{rec.worse.map((m) => (
          <li class="rule-t"><a href={url(`measures/${m.id}/`)} class="grid grid-cols-[1fr_auto] items-baseline gap-x-4 px-5 py-2.5 text-ink no-underline hover:bg-panel">
            <span class="font-semibold">{m.title}</span><span class="num font-bold text-bad">{rec.pick(m)!.label}</span>
            <span class="meta col-span-2">{rec.pick(m)!.periodLabel} · now {headlineText(m.headline)}</span></a></li>))}</ul>
      </div>
    </div>))}
  </section>

  <section class="wrap pt-20">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { href: 'budget/build/', eyebrow: 'Interactive', h: 'Build your own Federal Budget', p: 'Start from the real Budget. Change any tax or spending line and watch the deficit, debt and interest bill respond.' },
        { href: 'leadership/', eyebrow: 'Leadership', h: 'Tired government, tired answers', p: 'Decades in Parliament, and it shows. The case for fresh blood and term limits.' },
        { href: 'backflips/', eyebrow: 'Backflips', h: 'Announced, then abandoned', p: 'Big announcements that were watered down, delayed or dropped once they hit reality.' },
        { href: 'make-your-own-chart/', eyebrow: 'Free to reuse', h: 'Make your own chart', p: 'Download any series as a spreadsheet and redraw it for a flyer, a post or a speech, with the source credited in 1 line.' },
      ].map((c, i) => (
        <a href={url(c.href)} class="card card-link card-pad rise flex flex-col" style={`--i:${i}`}>
          <p class="eyebrow">{c.eyebrow}</p>
          <p class="mt-2 font-display text-[23px] font-semibold leading-tight">{c.h}</p>
          <p class="mt-2 text-[15px] text-ink-2">{c.p}</p>
          <p class="mt-5 inline-flex items-center gap-1.5 text-[14.5px] font-bold text-brand">Open <Icon name="arrow" size={15} /></p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap pt-20">
    <div class="card grid gap-6 bg-night p-7 text-on-night md:grid-cols-[1fr_auto] md:items-center md:p-10 cta-blue" style="border-color:transparent">
      <div>
        <h2 class="h2">Know when the numbers change</h2>
        <p class="mt-2 max-w-[60ch] text-[16px] text-ink-2">A short email when a new figure lands or another promise falls over. Unsubscribe any time.</p>
      </div>
      <a class="btn btn-primary" href={url('subscribe/')}><Icon name="bell" />Get email updates</a>
    </div>
  </section>
</Base>

<style>
  /* Hero: always on night, whatever the theme, so the mark and the orbit have the dark they need. */
  .hero { position: relative; overflow: hidden; background: var(--night); color: var(--on-night); isolation: isolate; }
  .hero-sky { position: absolute; inset: 0; z-index: -1; background:
      radial-gradient(60% 50% at 78% 45%, rgb(120 130 230 / 0.25) 0%, transparent 70%),
      radial-gradient(30% 30% at 88% 20%, color-mix(in srgb, var(--red) 14%, transparent) 0%, transparent 70%),
      linear-gradient(180deg, var(--night) 0%, var(--night-2) 100%); }
  .hero-sky::after { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgb(255 255 255 / 0.07) 0.6px, transparent 0.7px); background-size: 22px 22px; mask-image: radial-gradient(70% 70% at 70% 50%, #000 20%, transparent 100%); }
  .hero-grid { display: grid; grid-template-areas: 'orbit' 'copy' 'tally'; gap: 20px; padding-block: 16px 36px; }
  .hero-copy { grid-area: copy; } .hero-orbit { grid-area: orbit; } .hero-tally { grid-area: tally; }
  .hero-copy { max-width: 600px; }
  .hero-kicker { font-size: 13px; font-weight: 600; color: var(--on-night-2); }
  .hero-h { margin-top: 14px; font-size: clamp(40px, 5vw, 66px); color: var(--on-night); max-width: 11ch; }
  .hero-lede { margin-top: 20px; max-width: 54ch; font-size: clamp(17px, 1.7vw, 19px); line-height: 1.55; color: var(--on-night-2); }
  .btn-light { background: var(--on-night); color: var(--night); }
  @media (hover: hover) and (pointer: fine) { .btn-light:hover { background: #fff; } }
  .hero-link { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--on-night); text-decoration: none; }
  .hero-link:hover { text-decoration: underline; }
  .hero-tally { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 16px; padding-top: 18px; border-top: 1px solid var(--night-rule); font-size: 14px; color: var(--on-night-2); }
  .hero-tally li { display: inline-flex; align-items: center; gap: 7px; }
  .hero-tally b { font-size: 18px; color: var(--on-night); }
  .hero-tally i { width: 8px; height: 8px; border-radius: 50%; }
  .hero-tally a { color: var(--on-night); font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
  .hero-tally a:hover { text-decoration: underline; }
  .hero-orbit { width: 100%; }
  @media (min-width: 1024px) {
    /* Content sets the height: no viewport lock, so a tall screen doesn't leave a band of empty night above and below.
       The orbit takes the wider column and starts level with the headline; the commitments tally sits under it as a
       caption, which balances the two columns. */
    .hero-grid { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); grid-template-areas: 'copy orbit' 'copy tally'; grid-template-rows: auto 1fr; align-items: start; gap: 0 40px; padding-block: 48px 44px; }
    .hero-copy { padding-top: 24px; }
    .hero-orbit { justify-self: stretch; width: 100%; margin-top: -8px; }
    .hero-tally { justify-content: center; margin-top: 36px; padding-top: 16px; }
    .hero-grid { overflow: visible; }
  }

  /* Household type switch: plain radio buttons, so it works without JavaScript. */
  .wallet-toggle { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border: 0; margin: 0; max-width: 100%; border-radius: 24px; background: var(--panel); }
  .wallet-toggle label { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; white-space: nowrap; border-radius: 999px; font-weight: 700; font-size: 15px; color: var(--ink-2); cursor: pointer; transition: background-color 160ms ease, color 160ms ease; }
  @media (max-width: 420px) { .wallet-toggle label { padding: 0 10px; font-size: 13.5px; } }
  .wallet-toggle input:checked + label { background: var(--brand); color: var(--on-brand); }
  .wallet-toggle input:focus-visible + label { outline: 2px solid var(--brand); outline-offset: 2px; }
  .w-panel { display: none; }
  .wallet:has(#w-own:checked) .w-panel, .wallet:has(#w-rent:checked) .w-panel, .wallet:has(#w-single:checked) .w-panel { display: none; }
  .wallet:has(#w-own:checked) .w-own-panel, .wallet:has(#w-rent:checked) .w-rent-panel, .wallet:has(#w-single:checked) .w-single-panel { display: block; }
  .cta-blue :global(.h2) { color: #fff; } .cta-blue p { color: var(--on-night-2) !important; }
  .hero-h { max-width: 13ch !important; }
  .hero-red { color: #ff5a61; }

  /* Key figures: a swipeable row on phones, a grid on wider screens. */
  .tn-row { display: grid; gap: 16px; grid-auto-flow: column; grid-auto-columns: minmax(270px, 84%); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; margin-inline: -16px; padding-inline: 16px; scroll-padding-inline: 16px; }
  .tn-row > :global(*) { scroll-snap-align: start; }
  @media (min-width: 640px) { .tn-row { grid-auto-flow: row; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: visible; margin-inline: 0; padding-inline: 0; } }
  @media (min-width: 1024px) { .tn-row { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
